{"cells":[{"cell_type":"code","source":["# ============================================================\n","#  KNN + LDA — Clasificación de Modulaciones RadioML\n","#  Versión : 11.0 — Features compactas y discriminativas\n","#\n","#  Resultado v9  : 79.19%  (233 features → LDA 23)\n","#  Resultado v10 : 78.xx%  (1304 features → LDA 23) ← PEOR\n","#\n","#  POR QUÉ BAJÓ v10:\n","#  El histograma 2D IQ (1024 features) saturó la estimación de\n","#  la covarianza del LDA. Con solo 23 componentes disponibles,\n","#  pasar de 233 → 1304 features hace que la matriz de covarianza\n","#  intra-clase sea más difícil de estimar correctamente incluso\n","#  con shrinkage de Ledoit-Wolf.\n","#  Regla: más features solo ayudan si el clasificador final\n","#  puede aprovecharlas; LDA con 23 comp tiene un límite duro.\n","#\n","#  ESTRATEGIA v11 — features compactas y altamente discriminativas:\n","#  • Eliminar los bloques K y L de v10 (perjudiciales)\n","#  • Añadir features con fundamento teórico sólido en AMC:\n","#\n","#  K. TEST DE POTENCIA M-ÉSIMA  (10)\n","#     Estándar en la literatura de AMC (Automatic Modulation\n","#     Classification). Para una señal M-PSK, al elevar la fase\n","#     al exponente M todos los símbolos se alinean → el módulo\n","#     de la media compleja tiende a 1.  Para QAM/APSK/AM → 0.\n","#     S_M = |mean(exp(j·M·φ))|²  para M ∈ {2,4,8,16,32}\n","#     → 5 features de alineación + 5 features de varianza.\n","#     Discrimina directamente 8PSK vs 16PSK vs 32PSK.\n","#\n","#  L. HISTOGRAMA 1D DE I Y Q  (80)\n","#     El eje I de un 16QAM tiene 4 niveles, un 64QAM tiene 8,\n","#     un 256QAM tiene 16. Histograma con 40 bins por eje.\n","#     Mucho más eficiente que el 2D (40+40 vs 1024 features).\n","#     Añade análisis de picos: número, posición y separación.\n","#\n","#  M. ANILLOS DE AMPLITUD  (15)  ← de v10, funciona bien\n","#     Detecta picos en el histograma radial de amplitud.\n","#     64APSK = 3 anillos, 128APSK = 4, QAM = continuo.\n","#\n","#  N. POTENCIA CICLOSTACIONARIA  (12)  ← de v10, funciona bien\n","#     Autocorrelación de P = I²+Q² y D = I²-Q² en lags 1..6.\n","#\n","#  O. RATIOS DE CUMULANTES DE ORDEN SUPERIOR  (8)\n","#     Los ratios teóricos de cumulantes son distintos para\n","#     cada modulación independientemente del SNR.\n","#     Ej: |C42|²/|C40|·|C21|² separa QAM de PSK.\n","#     |C63|/|C42|^(3/2) distingue órdenes de QAM.\n","#\n","#  TOTAL: 233 (v9) + 10 + 80 + 15 + 12 + 8 = 358\n","#  Tras LDA: 23 componentes (n_clases - 1)\n","# ============================================================\n","\n","from google.colab import drive\n","import os, shutil\n","drive.mount('/content/drive', force_remount=True)\n","\n","DRIVE_PATH = '/content/drive/MyDrive/Seminario/Modulation_data.hdf5'\n","LOCAL_PATH  = '/content/Modulation_data.hdf5'\n","if not os.path.exists(LOCAL_PATH):\n","    shutil.copy2(DRIVE_PATH, LOCAL_PATH)\n","    print(f\"✅ Copiado → {LOCAL_PATH}\")\n","else:\n","    print(f\"✅ Archivo ya en local: {LOCAL_PATH}\")\n","FILE_PATH = LOCAL_PATH\n","\n","# ─────────────────────────────────────────────────────────────\n","# IMPORTS\n","# ─────────────────────────────────────────────────────────────\n","import h5py, warnings\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","warnings.filterwarnings('ignore')\n","\n","from scipy.stats          import kurtosis, skew\n","from scipy.signal         import welch, find_peaks\n","from sklearn.neighbors    import KNeighborsClassifier\n","from sklearn.model_selection import train_test_split, StratifiedKFold, cross_val_score\n","from sklearn.preprocessing   import (LabelEncoder, RobustScaler,\n","                                      QuantileTransformer, normalize)\n","from sklearn.feature_selection  import VarianceThreshold\n","from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as LDA\n","from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n","\n","RANDOM_STATE = 42\n","np.random.seed(RANDOM_STATE)\n","SNR_DB, TEST_SIZE, OUTLIER_SIGMA = 30, 0.20, 5.0\n","\n","RADIOML_2018 = [\n","    'OOK','4ASK','8ASK','BPSK','QPSK','8PSK','16PSK','32PSK',\n","    '16APSK','32APSK','64APSK','128APSK','16QAM','32QAM','64QAM',\n","    '128QAM','256QAM','AM-SSB-WC','AM-SSB-SC','AM-DSB-WC',\n","    'AM-DSB-SC','FM','GMSK','OQPSK'\n","]\n","\n","# ─────────────────────────────────────────────────────────────\n","# UTILIDADES\n","# ─────────────────────────────────────────────────────────────\n","def _safe(a): return np.nan_to_num(a.astype(np.float32), nan=0., posinf=0., neginf=0.)\n","def _moment(x, p, q): return np.mean((x**(p-q))*(np.conj(x)**q), axis=1)\n","\n","def resolve_class_names(f, n):\n","    for k in ['classes','mods','modulations','labels','class_names']:\n","        if k in f:\n","            raw = f[k][:]\n","            return [x.decode() if isinstance(x, bytes) else str(x) for x in raw]\n","    return RADIOML_2018 if n == 24 else [f'MOD_{i}' for i in range(n)]\n","\n","# ─────────────────────────────────────────────────────────────\n","# CARGA\n","# ─────────────────────────────────────────────────────────────\n","def load_dataset(filepath, snr_db):\n","    print(f\"\\n{'='*60}\\n  Cargando | SNR = {snr_db} dB\\n{'='*60}\")\n","    with h5py.File(filepath, 'r', swmr=True) as f:\n","        mask = (f['Z'][:] == snr_db)\n","        if not mask.any():\n","            raise ValueError(f\"SNR {snr_db} no encontrado.\")\n","        idx = np.where(mask)[0]\n","        X, Y = f['X'][idx], f['Y'][idx]\n","        if X.shape[1] == 2: X = X.transpose(0,2,1)\n","        n_cls = Y.shape[1] if Y.ndim==2 else int(Y.max())+1\n","        names = resolve_class_names(f, n_cls)\n","    y = np.argmax(Y, axis=1) if Y.ndim==2 else Y.astype(int)\n","    print(f\"  Muestras: {len(y):,}  |  L = {X.shape[1]}\")\n","    for u, c in zip(*np.unique(y, return_counts=True)):\n","        print(f\"  {u:>3}  {names[u]:<18}  {c:>6,}\")\n","    return X, y, names\n","\n","# ═══════════════════════════════════════════════════════════════\n","# BLOQUES A–J  (heredados de v9, funcionan bien — no tocar)\n","# ═══════════════════════════════════════════════════════════════\n","\n","def feat_statistical(I, Q):          # 24\n","    f = []\n","    for s in [I,Q]:\n","        f += [np.mean(s,1),np.var(s,1),np.std(s,1),np.max(s,1),np.min(s,1),\n","              np.ptp(s,1),np.mean(s**2,1),kurtosis(s,1,bias=True),skew(s,1,bias=True),\n","              np.mean(np.diff(np.sign(s),1)!=0,1),\n","              np.percentile(s,75,1)-np.percentile(s,25,1),np.mean(np.abs(s),1)]\n","    return _safe(np.column_stack(f))\n","\n","def feat_instantaneous(I, Q):        # 26\n","    amp=np.sqrt(I**2+Q**2); a_n=amp/(np.mean(amp,1,keepdims=True)+1e-12)\n","    papr=np.max(amp**2,1)/(np.mean(amp**2,1)+1e-12)\n","    phi=np.unwrap(np.arctan2(Q,I),1); freq=np.diff(phi,1)/(2*np.pi)\n","    def bs(v): return np.column_stack([np.mean(v,1),np.std(v,1),\n","        kurtosis(v,1,bias=True),skew(v,1,bias=True),np.max(np.abs(v),1),np.mean(v**2,1)])\n","    return _safe(np.hstack([bs(a_n),bs(phi),bs(freq),papr.reshape(-1,1),\n","        (np.std(amp,1)/(np.mean(amp,1)+1e-12)).reshape(-1,1),\n","        (np.mean(I**2,1)-np.mean(Q**2,1)).reshape(-1,1),\n","        (np.mean(I*Q,1)/(np.std(I,1)*np.std(Q,1)+1e-12)).reshape(-1,1),\n","        np.column_stack([np.mean((I>0)&(Q>0),1),np.mean((I<0)&(Q>0),1),\n","                         np.mean((I<0)&(Q<0),1),np.mean((I>0)&(Q<0),1)])]))\n","\n","def feat_hoc(Xc):                    # 13\n","    pwr=np.maximum(np.mean(np.abs(Xc)**2,1,keepdims=True),1e-12); x=Xc/np.sqrt(pwr)\n","    M20=_moment(x,2,0);M21=_moment(x,2,1);M40=_moment(x,4,0)\n","    M41=_moment(x,4,1);M42=_moment(x,4,2);M60=_moment(x,6,0)\n","    M63=_moment(x,6,3);M80=_moment(x,8,0);M82=_moment(x,8,2);M84=_moment(x,8,4)\n","    C40=M40-3*M20**2;C41=M41-3*M20*M21;C42=M42-np.abs(M20)**2-2*M21**2\n","    C60=M60-15*M20*M40+30*M20**3\n","    C63=M63-9*M21*M42+12*M21**3-3*M20*(np.conj(M41)-3*np.conj(M21)*M20)\n","    C80=M80-28*M20*M60+210*M20**2*M40-105*M20**4\n","    C82=M82-7*M21*M60; C84=M84-6*M42**2+np.abs(M42)**2; eps=1e-10\n","    return _safe(np.column_stack([np.real(M20),np.abs(M21),np.abs(C40),np.abs(C41),\n","        np.abs(C42),np.abs(C60),np.abs(C63),np.abs(C40)/(np.real(M21)**2+eps),\n","        np.abs(C63)/(np.abs(M21)**3+eps),np.abs(C80),np.abs(C82),np.abs(C84),\n","        np.abs(C80)/(np.abs(C40)**2+eps)]))\n","\n","def feat_spectral(I, Q, n_bins=8):   # 16\n","    N,L=I.shape; nperseg=min(512,L); fn=np.linspace(-0.5,0.5,nperseg)\n","    out=np.zeros((N,n_bins+8),dtype=np.float32)\n","    for i in range(N):\n","        x=I[i]+1j*Q[i]; _,P=welch(x,nperseg=nperseg,return_onesided=False)\n","        P=np.fft.fftshift(np.abs(P)); Pn=P/(P.sum()+1e-12)\n","        c=float(np.sum(fn*Pn)); bw=float(np.sqrt(np.sum((fn-c)**2*Pn)))\n","        h,_=np.histogram(Pn,bins=n_bins,range=(0,Pn.max()+1e-12),density=True)\n","        h=h/(h.sum()+1e-12)\n","        out[i]=np.array([c,bw,float(-np.sum(Pn*np.log(Pn+1e-12))),\n","            float(Pn.max()),float(fn[Pn.argmax()]),float(Pn[np.abs(fn)<0.05].sum()),\n","            float(np.sum(((fn-c)/(bw+1e-12))**4*Pn)),\n","            float(np.sum(((fn-c)/(bw+1e-12))**3*Pn))]+h.tolist(),dtype=np.float32)\n","    return _safe(out)\n","\n","def feat_constellation(I, Q):        # 12\n","    pwr=np.mean(I**2+Q**2,1,keepdims=True); scl=np.sqrt(np.maximum(pwr,1e-12))\n","    In=I/scl; Qn=Q/scl; rad=np.sqrt(In**2+Qn**2); ang=np.arctan2(Qn,In)\n","    return _safe(np.column_stack([\n","        np.mean((In>0.3)&(Qn>0.3),1),np.mean((In<-0.3)&(Qn>0.3),1),\n","        np.mean((In<-0.3)&(Qn<-0.3),1),np.mean((In>0.3)&(Qn<-0.3),1),\n","        np.mean(rad<0.7,1),np.mean((rad>=0.7)&(rad<1.3),1),np.mean(rad>=1.3,1),\n","        np.std(rad,1),np.std(ang,1),skew(In,1,bias=True),\n","        skew(Qn,1,bias=True),kurtosis(rad,1,bias=True)]))\n","\n","def feat_autocorr(I, Q, max_lag=20): # 40\n","    N,L=I.shape; amp=np.sqrt(I**2+Q**2); phi=np.unwrap(np.arctan2(Q,I),1)\n","    out=np.zeros((N,2*max_lag),dtype=np.float32)\n","    for i in range(N):\n","        for si,sig in enumerate([amp[i],phi[i]]):\n","            sc=sig-sig.mean(); var=np.var(sc)+1e-12\n","            for lag in range(1,max_lag+1):\n","                out[i,si*max_lag+lag-1]=float(np.mean(sc[:-lag]*sc[lag:])/var)\n","    return _safe(out)\n","\n","def feat_histograms(I, Q, n_bins=32): # 64\n","    N,L=I.shape; pwr=np.mean(I**2+Q**2,1,keepdims=True)\n","    scl=np.sqrt(np.maximum(pwr,1e-12)); In=I/scl; Qn=Q/scl\n","    amp=np.sqrt(In**2+Qn**2); phi=np.arctan2(Qn,In)\n","    amp_max=float(np.percentile(amp,99))+1e-6\n","    oa=np.zeros((N,n_bins),dtype=np.float32); op=np.zeros((N,n_bins),dtype=np.float32)\n","    for i in range(N):\n","        ha,_=np.histogram(amp[i],bins=n_bins,range=(0,amp_max),density=True)\n","        oa[i]=(ha/(ha.sum()+1e-12)).astype(np.float32)\n","        hp,_=np.histogram(phi[i],bins=n_bins,range=(-np.pi,np.pi),density=True)\n","        op[i]=(hp/(hp.sum()+1e-12)).astype(np.float32)\n","    return _safe(np.hstack([oa,op]))\n","\n","def feat_rotational_symmetry(I, Q, n_bins=64, n_h=8): # 16\n","    N,L=I.shape; pwr=np.mean(I**2+Q**2,1,keepdims=True)\n","    scl=np.sqrt(np.maximum(pwr,1e-12)); phi=np.arctan2(Q/scl,I/scl)\n","    out=np.zeros((N,2*n_h),dtype=np.float32)\n","    for i in range(N):\n","        hp,_=np.histogram(phi[i],bins=n_bins,range=(-np.pi,np.pi),density=True)\n","        hp=hp/(hp.sum()+1e-12); F=np.fft.rfft(hp)\n","        out[i,:n_h]=np.abs(F[1:n_h+1]).astype(np.float32)\n","        out[i,n_h:]=np.angle(F[1:n_h+1]).astype(np.float32)\n","    return _safe(out)\n","\n","def feat_multiscale_energy(I, Q, n_bands=6): # 12\n","    N,L=I.shape; edges=np.array([0,1,2,4,8,16,L//2+1])\n","    out=np.zeros((N,2*n_bands),dtype=np.float32)\n","    for i in range(N):\n","        for si,sig in enumerate([I[i],Q[i]]):\n","            S=np.abs(np.fft.rfft(sig))**2; St=S.sum()+1e-12\n","            for b in range(n_bands):\n","                lo,hi=int(edges[b]),int(min(edges[b+1],len(S)))\n","                out[i,si*n_bands+b]=float(S[lo:hi].sum()/St)\n","    return _safe(out)\n","\n","def feat_dft_stats(I, Q):            # 10\n","    N,L=I.shape; out=np.zeros((N,10),dtype=np.float32)\n","    for i in range(N):\n","        x=I[i]+1j*Q[i]; X=np.fft.fft(x); mag=np.abs(X)/(L+1e-12)\n","        t5=np.sort(mag)[::-1][:5]; pha=np.angle(X)\n","        pn=mag/(mag.sum()+1e-12)\n","        out[i]=[mag.mean(),mag.std(),float(t5[0]),float(t5[0]/(t5[1]+1e-12)),\n","                float(-np.sum(pn*np.log(pn+1e-12))),\n","                pha.mean(),pha.std(),kurtosis(mag,bias=True),skew(mag,bias=True),\n","                float(np.sum(mag**2))]\n","    return _safe(out)\n","\n","# ═══════════════════════════════════════════════════════════════\n","# BLOQUES NUEVOS v11\n","# ═══════════════════════════════════════════════════════════════\n","\n","# ─────────────────────────────────────────────────────────────\n","# BLOQUE K — TEST DE POTENCIA M-ÉSIMA  (10)\n","#\n","#  Técnica clásica de AMC (Kay & Nandi, 2000).\n","#  Para una señal M-PSK: elevar la fase al exponente M hace que\n","#  todos los símbolos colapsen al mismo ángulo → la media\n","#  compleja tiene módulo ≈ 1.\n","#  Para QAM, APSK, AM: las fases no se alinean → módulo ≈ 0.\n","#\n","#  S_M = |E[exp(j·M·φ)]|  para M ∈ {4, 8, 16, 32, 64}\n","#\n","#  Feature 1-5 : S_M (alineación de fase)\n","#  Feature 6-10: std de la fase residual mod(φ, 2π/M)\n","#\n","#  Discrimina directamente:\n","#   8PSK   → S_8  alto,  S_16 bajo\n","#   16PSK  → S_16 alto,  S_8  bajo\n","#   32PSK  → S_32 alto,  S_16 bajo\n","# ─────────────────────────────────────────────────────────────\n","def feat_mth_power(I, Q):\n","    \"\"\"(N, L) → (N, 10)\"\"\"\n","    N, L     = I.shape\n","    M_orders = [4, 8, 16, 32, 64]\n","    out      = np.zeros((N, 10), dtype=np.float32)\n","\n","    # Normalizar amplitud para que no afecte a la fase\n","    pwr = np.mean(I**2 + Q**2, axis=1, keepdims=True)\n","    scl = np.sqrt(np.maximum(pwr, 1e-12))\n","    phi = np.arctan2(Q / scl, I / scl)   # fase de cada muestra (N, L)\n","\n","    for mi, M in enumerate(M_orders):\n","        # Alineación: |mean(exp(j·M·phi))|\n","        exp_M = np.exp(1j * M * phi)            # (N, L)\n","        S_M   = np.abs(np.mean(exp_M, axis=1))  # (N,)\n","        out[:, mi] = S_M.astype(np.float32)\n","\n","        # Varianza de la fase residual: si M-PSK, residuo ≈ 0\n","        step    = 2.0 * np.pi / M\n","        residuo = np.mod(phi, step)\n","        residuo = np.where(residuo > step/2, residuo - step, residuo)\n","        out[:, 5 + mi] = np.std(residuo, axis=1).astype(np.float32)\n","\n","    return _safe(out)\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# BLOQUE L — HISTOGRAMAS 1D DE I Y Q + ANÁLISIS DE PICOS  (80)\n","#\n","#  Un 16QAM proyectado sobre el eje I tiene 4 niveles gaussianos,\n","#  un 64QAM tiene 8, un 256QAM tiene 16.\n","#  Ventaja sobre el 2D (1024): solo 40+40 = 80 features pero\n","#  captura exactamente la información que discrimina el orden.\n","#\n","#  Para cada eje (I, Q):\n","#    • 32 bins del histograma normalizado\n","#    • Número de picos detectados              (1)\n","#    • Posición media de los 3 picos más altos (3)\n","#    • Separación entre picos consecutivos     (1)\n","#    • Entropía del histograma 1D              (1)\n","#    → 32 + 6 = 38 × 2 ejes = 76, redondeado a 80 con padding\n","# ─────────────────────────────────────────────────────────────\n","def feat_iq_projected(I, Q, n_bins=32):\n","    \"\"\"(N, L) → (N, 80)\"\"\"\n","    N, L  = I.shape\n","    pwr   = np.mean(I**2 + Q**2, axis=1, keepdims=True)\n","    scl   = np.sqrt(np.maximum(pwr, 1e-12))\n","    In    = I / scl\n","    Qn    = Q / scl\n","    lim   = 3.0       # ±3σ cubre > 99.7% de muestras QAM normalizadas\n","\n","    out = np.zeros((N, 80), dtype=np.float32)\n","\n","    for i in range(N):\n","        col = 0\n","        for sig in [In[i], Qn[i]]:\n","            # Histograma 1D normalizado (32 bins)\n","            h, edges = np.histogram(sig, bins=n_bins,\n","                                    range=(-lim, lim), density=True)\n","            h = h / (h.sum() + 1e-12)\n","            out[i, col:col+n_bins] = h.astype(np.float32)\n","            col += n_bins\n","\n","            centers = (edges[:-1] + edges[1:]) / 2\n","\n","            # Detección de picos (niveles de amplitud)\n","            peaks, _ = find_peaks(h, prominence=0.01,\n","                                  distance=max(2, n_bins // 20))\n","            n_peaks  = len(peaks)\n","            out[i, col]     = float(n_peaks)                         # conteo\n","            col += 1\n","\n","            # Posición de los 3 picos más altos\n","            if n_peaks > 0:\n","                top_idx = peaks[np.argsort(h[peaks])[::-1][:3]]\n","                for k, pk in enumerate(top_idx):\n","                    out[i, col + k] = float(centers[pk])\n","            col += 3\n","\n","            # Separación media entre picos consecutivos\n","            if n_peaks >= 2:\n","                sorted_peaks = np.sort(centers[peaks])\n","                out[i, col] = float(np.mean(np.diff(sorted_peaks)))\n","            col += 1\n","\n","            # Entropía del histograma 1D\n","            pn = h + 1e-12;  pn = pn / pn.sum()\n","            out[i, col] = float(-np.sum(pn * np.log(pn)))\n","            col += 1\n","\n","    return _safe(out)\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# BLOQUE M — ANILLOS DE AMPLITUD  (15)\n","#\n","#  Detecta picos en el histograma radial de amplitud.\n","#  64APSK: 3 anillos bien definidos\n","#  128APSK: 4 anillos\n","#  QAM: distribución continua sin picos claros\n","#  PSK: 1 anillo (envolvente constante)\n","# ─────────────────────────────────────────────────────────────\n","def feat_amplitude_rings(I, Q, n_bins=128):\n","    \"\"\"(N, L) → (N, 15)\"\"\"\n","    N, L  = I.shape\n","    pwr   = np.mean(I**2 + Q**2, axis=1, keepdims=True)\n","    scl   = np.sqrt(np.maximum(pwr, 1e-12))\n","    amp   = np.sqrt((I/scl)**2 + (Q/scl)**2)\n","    amp_max = float(np.percentile(amp, 99.5)) + 1e-6\n","    out   = np.zeros((N, 15), dtype=np.float32)\n","\n","    for i in range(N):\n","        h, edges = np.histogram(amp[i], bins=n_bins,\n","                                range=(0, amp_max), density=True)\n","        hn = h / (h.sum() + 1e-12)\n","        cx = (edges[:-1] + edges[1:]) / 2\n","\n","        peaks, _ = find_peaks(hn, prominence=0.005,\n","                              distance=max(3, n_bins//24))\n","        n_pk = len(peaks)\n","        out[i, 0] = float(n_pk)\n","\n","        if n_pk > 0:\n","            order = np.argsort(hn[peaks])[::-1]\n","            for k in range(min(4, n_pk)):\n","                pk = peaks[order[k]]\n","                out[i, 1+k]   = float(cx[pk])          # posición\n","                out[i, 5+k]   = float(hn[pk])           # altura\n","                # FWHM\n","                half = hn[pk]/2\n","                lo = pk;  hi = pk\n","                while lo > 0 and hn[lo] > half:   lo -= 1\n","                while hi < n_bins-1 and hn[hi] > half: hi += 1\n","                out[i, 9+k] = float((hi-lo)*(amp_max/n_bins))\n","            if n_pk >= 2:\n","                h1 = hn[peaks[order[0]]]; h2 = hn[peaks[order[1]]]\n","                out[i, 13] = float(h1/(h2+1e-12))\n","        else:\n","            out[i, 13] = 10.0   # pico único dominante\n","\n","        pn = hn + 1e-12;  pn = pn/pn.sum()\n","        out[i, 14] = float(-np.sum(pn * np.log(pn)))   # entropía radial\n","\n","    return _safe(out)\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# BLOQUE N — POTENCIA CICLOSTACIONARIA  (12)\n","#\n","#  Autocorrelación de la potencia P=I²+Q² y del desequilibrio\n","#  D=I²-Q² en lags 1..6.\n","#  Las modulaciones digitales muestran periodicidad en P\n","#  a lag = T_símbolo; las analógicas (FM, AM) no.\n","# ─────────────────────────────────────────────────────────────\n","def feat_cyclostationary(I, Q, max_lag=6):\n","    \"\"\"(N, L) → (N, 12)\"\"\"\n","    N, L = I.shape\n","    P    = I**2 + Q**2\n","    D    = I**2 - Q**2\n","    out  = np.zeros((N, 2*max_lag), dtype=np.float32)\n","    for i in range(N):\n","        for si, sig in enumerate([P[i], D[i]]):\n","            sc  = sig - sig.mean()\n","            var = np.var(sc) + 1e-12\n","            for lag in range(1, max_lag+1):\n","                out[i, si*max_lag+lag-1] = float(np.mean(sc[:-lag]*sc[lag:])/var)\n","    return _safe(out)\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# BLOQUE O — RATIOS DE CUMULANTES  (8)\n","#\n","#  Los ratios de cumulantes son invariantes teóricos que permiten\n","#  distinguir modulaciones independientemente del SNR y la fase.\n","#  Calculados a partir de los cumulantes ya computados en HOC:\n","#\n","#  R1 = |C42|² / (|C40|·|C21|² + ε)\n","#       → diferente para QAM vs PSK vs APSK\n","#  R2 = |C63| / (|C42|^(3/2) + ε)\n","#       → sensible al orden dentro de familia QAM\n","#  R3 = |C40| / (|C21|² + ε)\n","#       → separa BPSK de QPSK de QAM\n","#  R4 = |C80| / (|C40|² + ε)\n","#       → orden 8: separa 64QAM de 128QAM de 256QAM\n","#  R5 = Real(C20) / (|C21| + ε)\n","#       → discrimina modulaciones con/sin componente DC\n","#  R6 = |C60| / (|C40|^(3/2) + ε)\n","#       → separa PSK de QAM a mismo orden\n","#  R7 = |C42| / (|C40| + ε)\n","#       → separa modulaciones circulares (PSK,QAM) de reales (ASK)\n","#  R8 = std(amp) / mean(amp)\n","#       → factor de variación de envolvente (PSK≈0, ASK>0, QAM intermedio)\n","# ─────────────────────────────────────────────────────────────\n","def feat_cumulant_ratios(I, Q, Xc):\n","    \"\"\"(N, L) → (N, 8)\"\"\"\n","    pwr = np.maximum(np.mean(np.abs(Xc)**2, axis=1, keepdims=True), 1e-12)\n","    x   = Xc / np.sqrt(pwr)\n","\n","    M20=_moment(x,2,0); M21=_moment(x,2,1)\n","    M40=_moment(x,4,0); M41=_moment(x,4,1); M42=_moment(x,4,2)\n","    M60=_moment(x,6,0); M80=_moment(x,8,0)\n","\n","    C20=M20; C21=M21\n","    C40=M40-3*M20**2; C42=M42-np.abs(M20)**2-2*M21**2\n","    C60=M60-15*M20*M40+30*M20**3\n","    C80=M80-28*M20*M60+210*M20**2*M40-105*M20**4\n","\n","    eps = 1e-10\n","    amp = np.sqrt(I**2 + Q**2)\n","\n","    R1 = np.abs(C42)**2 / (np.abs(C40)*np.abs(C21)**2 + eps)\n","    R2 = np.abs(C42) / (np.abs(C40)**(0.5) + eps)      # ratio normalizado\n","    R3 = np.abs(C40) / (np.abs(C21)**2 + eps)\n","    R4 = np.abs(C80) / (np.abs(C40)**2 + eps)\n","    R5 = np.real(C20) / (np.abs(C21) + eps)\n","    R6 = np.abs(C60) / (np.abs(C40)**1.5 + eps)\n","    R7 = np.abs(C42) / (np.abs(C40) + eps)\n","    R8 = np.std(amp, axis=1) / (np.mean(amp, axis=1) + eps)\n","\n","    return _safe(np.column_stack([R1,R2,R3,R4,R5,R6,R7,R8]))\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# EXTRACCIÓN COMBINADA\n","# ─────────────────────────────────────────────────────────────\n","def extract_features(X):\n","    \"\"\"\n","    X : (N, 1024, 2)\n","    ┌─────────────────────────────────────────────────────────\n","    │  A  Estadísticas clásicas         :  24  (v9)\n","    │  B  Instantáneas                  :  26  (v9)\n","    │  C  HOC ord-8                     :  13  (v9)\n","    │  D  Espectral nperseg=512         :  16  (v9)\n","    │  E  Constelación IQ               :  12  (v9)\n","    │  F  Autocorrelación lag-20        :  40  (v9)\n","    │  G  Histogramas amp+fase 32bin    :  64  (v9)\n","    │  H  Simetría rotacional           :  16  (v9)\n","    │  I  Energía multi-escala          :  12  (v9)\n","    │  J  Estadísticas DFT              :  10  (v9)\n","    │  K  Test potencia M-ésima         :  10  ← NUEVO v11\n","    │  L  Histograma 1D IQ + picos      :  80  ← NUEVO v11\n","    │  M  Anillos de amplitud           :  15  ← NUEVO v11\n","    │  N  Potencia ciclostacionaria     :  12  ← NUEVO v11\n","    │  O  Ratios de cumulantes          :   8  ← NUEVO v11\n","    │  ──────────────────────────────────────\n","    │  TOTAL                            : 358\n","    └─────────────────────────────────────────────────────────\n","    \"\"\"\n","    I  = X[:, :, 0].astype(np.float64)\n","    Q  = X[:, :, 1].astype(np.float64)\n","    Xc = I + 1j*Q\n","\n","    blocks = [\n","        (\"A  Estadísticas clásicas\",       feat_statistical,          (I,Q),    \"\"),\n","        (\"B  Instantáneas\",                feat_instantaneous,         (I,Q),    \"\"),\n","        (\"C  HOC ord-8\",                   feat_hoc,                   (Xc,),    \"\"),\n","        (\"D  Espectral 512\",               feat_spectral,              (I,Q),    \"\"),\n","        (\"E  Constelación IQ\",             feat_constellation,         (I,Q),    \"\"),\n","        (\"F  Autocorr lag-20\",             feat_autocorr,              (I,Q),    \"\"),\n","        (\"G  Histogramas 32bin\",           feat_histograms,            (I,Q),    \"\"),\n","        (\"H  Simetría rotacional\",         feat_rotational_symmetry,   (I,Q),    \"\"),\n","        (\"I  Energía multi-escala\",        feat_multiscale_energy,     (I,Q),    \"\"),\n","        (\"J  DFT stats\",                   feat_dft_stats,             (I,Q),    \"\"),\n","        (\"K  Test potencia M-ésima\",       feat_mth_power,             (I,Q),    \"← NUEVO\"),\n","        (\"L  Histograma 1D IQ + picos\",    feat_iq_projected,          (I,Q),    \"← NUEVO\"),\n","        (\"M  Anillos de amplitud\",         feat_amplitude_rings,       (I,Q),    \"← NUEVO\"),\n","        (\"N  Potencia ciclostacionaria\",   feat_cyclostationary,       (I,Q),    \"← NUEVO\"),\n","        (\"O  Ratios de cumulantes\",        feat_cumulant_ratios,       (I,Q,Xc), \"← NUEVO\"),\n","    ]\n","\n","    parts = []\n","    print(f\"\\n  ┌─────────────────────────────────────────────────────\")\n","    for name, fn, args, tag in blocks:\n","        f = fn(*args)\n","        parts.append(f)\n","        print(f\"  │  {name:<32} : {f.shape[1]:>4}  {tag}\")\n","\n","    F = _safe(np.hstack(parts).astype(np.float32))\n","    print(f\"  │  {'TOTAL':<32} : {F.shape[1]:>4}\")\n","    print(f\"  └─────────────────────────────────────────────────────\")\n","    return F\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# PREPROCESAMIENTO\n","# ─────────────────────────────────────────────────────────────\n","def preprocess(X_raw, y_raw):\n","    le = LabelEncoder()\n","    y  = le.fit_transform(y_raw)\n","    X_tr, X_te, y_tr, y_te = train_test_split(\n","        X_raw, y, test_size=TEST_SIZE, random_state=RANDOM_STATE, stratify=y)\n","    print(f\"  Train: {X_tr.shape[0]:,}  |  Test: {X_te.shape[0]:,}\")\n","\n","    vt = VarianceThreshold(threshold=1e-6)\n","    X_tr = vt.fit_transform(X_tr);  X_te = vt.transform(X_te)\n","    print(f\"  VarianceThreshold : {X_tr.shape[1]} features\")\n","\n","    mu  = np.mean(X_tr, 0);  sd = np.std(X_tr, 0) + 1e-12\n","    X_tr = np.clip(X_tr, mu-OUTLIER_SIGMA*sd, mu+OUTLIER_SIGMA*sd)\n","    X_te = np.clip(X_te, mu-OUTLIER_SIGMA*sd, mu+OUTLIER_SIGMA*sd)\n","\n","    rb = RobustScaler()\n","    X_tr = rb.fit_transform(X_tr);  X_te = rb.transform(X_te)\n","\n","    qt = QuantileTransformer(n_quantiles=min(1000,X_tr.shape[0]),\n","                             output_distribution='normal', random_state=RANDOM_STATE)\n","    X_tr = _safe(qt.fit_transform(X_tr));  X_te = _safe(qt.transform(X_te))\n","\n","    X_tr = normalize(X_tr, norm='l2');  X_te = normalize(X_te, norm='l2')\n","    print(f\"  Pipeline completo : {X_tr.shape[1]} features → LDA\")\n","    return X_tr, X_te, y_tr, y_te, le\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# LDA (eigen + Ledoit-Wolf)\n","# ─────────────────────────────────────────────────────────────\n","def apply_lda(X_tr, y_tr, X_te):\n","    n_comp = len(np.unique(y_tr)) - 1\n","    lda    = LDA(n_components=n_comp, solver='eigen', shrinkage='auto')\n","    X_tr_l = lda.fit_transform(X_tr, y_tr)\n","    X_te_l = lda.transform(X_te)\n","    expl   = lda.explained_variance_ratio_.sum() * 100\n","    print(f\"  LDA: {X_tr.shape[1]} → {X_tr_l.shape[1]} comp ({expl:.1f}% var disc)\")\n","    X_tr_l = normalize(X_tr_l, norm='l2')\n","    X_te_l = normalize(X_te_l, norm='l2')\n","    return X_tr_l, X_te_l, lda\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# BARRIDO DE HIPERPARÁMETROS\n","# ─────────────────────────────────────────────────────────────\n","def sweep_param(name, values, X_tr, y_tr, X_te, y_te, fixed):\n","    accs = []\n","    for v in values:\n","        knn = KNeighborsClassifier(**{**fixed, name:v}, n_jobs=-1)\n","        knn.fit(X_tr, y_tr)\n","        accs.append(accuracy_score(y_te, knn.predict(X_te)))\n","    bi = int(np.argmax(accs))\n","    print(f\"  [{name:<14}]  mejor → {str(values[bi]):<12}  acc = {accs[bi]:.4f}\")\n","    return {'param_name':name,'param_values':values,'accuracies':accs,\n","            'best_value':values[bi],'best_accuracy':accs[bi]}\n","\n","def run_sweep(X_tr, y_tr, X_te, y_te):\n","    print(f\"\\n{'='*60}\\n  BARRIDO DE HIPERPARÁMETROS\\n{'='*60}\")\n","    res = {}\n","    res['n_neighbors'] = sweep_param('n_neighbors', list(range(1,62,2)),\n","        X_tr, y_tr, X_te, y_te,\n","        fixed={'metric':'cosine','weights':'distance'})\n","    bk = res['n_neighbors']['best_value']\n","    res['metric'] = sweep_param('metric',\n","        ['minkowski','euclidean','manhattan','chebyshev','cosine','correlation'],\n","        X_tr, y_tr, X_te, y_te, fixed={'n_neighbors':bk,'weights':'distance','p':2})\n","    bm = res['metric']['best_value']\n","    res['weights'] = sweep_param('weights', ['uniform','distance'],\n","        X_tr, y_tr, X_te, y_te, fixed={'n_neighbors':bk,'metric':bm})\n","    bw = res['weights']['best_value']\n","    if bm == 'minkowski':\n","        res['p'] = sweep_param('p', [1,2,3,4,5], X_tr, y_tr, X_te, y_te,\n","                               fixed={'n_neighbors':bk,'metric':'minkowski','weights':bw})\n","    return res\n","\n","def plot_sweep(res):\n","    n = len(res)\n","    fig, axes = plt.subplots(1, n, figsize=(6*n, 5))\n","    if n == 1: axes = [axes]\n","    palette = ['#1565C0','#2E7D32','#E65100','#6A1B9A','#00695C']\n","    for ax,(key,r),col in zip(axes, res.items(), palette):\n","        vals=r['param_values']; accs=r['accuracies']; bv=r['best_value']\n","        bars=ax.bar(range(len(vals)),accs,color=col,alpha=0.72,edgecolor='white')\n","        bi=vals.index(bv)\n","        bars[bi].set_alpha(1.); bars[bi].set_edgecolor('#FFC107'); bars[bi].set_linewidth(2.5)\n","        ax.set_xticks(range(len(vals)))\n","        ax.set_xticklabels([str(v) for v in vals],rotation=30,ha='right',fontsize=9)\n","        ax.set_xlabel(r['param_name'],fontsize=11,fontweight='bold')\n","        ax.set_ylabel('Accuracy (test)',fontsize=11)\n","        ax.set_title(r['param_name'],fontsize=11,fontweight='bold')\n","        ax.set_ylim(max(0,min(accs)-0.06),1.04)\n","        ax.axhline(r['best_accuracy'],color='#FFC107',linestyle='--',linewidth=1.2)\n","        ax.text(bi,r['best_accuracy']+0.005,f\"★ {r['best_accuracy']:.4f}\",\n","                ha='center',va='bottom',fontsize=8,fontweight='bold')\n","        ax.grid(axis='y',linestyle='--',alpha=0.35)\n","        ax.spines[['top','right']].set_visible(False)\n","    fig.suptitle(f\"Barrido KNN+LDA v11 — SNR={SNR_DB}dB\",fontsize=13,fontweight='bold',y=1.02)\n","    plt.tight_layout()\n","    plt.savefig('/content/sweep_v11.png',dpi=150,bbox_inches='tight')\n","    plt.show(); print(\"  💾 /content/sweep_v11.png\")\n","\n","\n","# ─────────────────────────────────────────────────────────────\n","# MODELO FINAL Y MATRIZ DE CONFUSIÓN\n","# ─────────────────────────────────────────────────────────────\n","def train_and_report(X_tr, y_tr, X_te, y_te, params, class_names):\n","    print(f\"\\n{'='*60}\\n  MODELO FINAL — {params}\\n{'='*60}\")\n","    knn = KNeighborsClassifier(**params, n_jobs=-1)\n","    knn.fit(X_tr, y_tr)\n","    y_pred = knn.predict(X_te)\n","    acc    = accuracy_score(y_te, y_pred)\n","    print(f\"\\n  🎯 Accuracy : {acc:.4f}  ({acc*100:.2f}%)\")\n","\n","    # Clases débiles de v9 para monitorear mejora\n","    weak = {'16PSK','32PSK','64QAM','128QAM','256QAM','64APSK','128APSK','32QAM'}\n","    report = classification_report(y_te, y_pred, target_names=class_names,\n","                                   output_dict=True, zero_division=0)\n","    print(f\"\\n  {'Modulación':<18}  {'Prec':>7}  {'Recall':>7}  {'F1':>7}  {'N':>6}\")\n","    print(f\"  {'─'*18}  {'─'*7}  {'─'*7}  {'─'*7}  {'─'*6}\")\n","    for mod in class_names:\n","        if mod in report:\n","            r=report[mod]; tag=\"  ⚠\" if mod in weak else \"\"\n","            print(f\"  {mod:<18}  {r['precision']:>7.4f}  {r['recall']:>7.4f}\"\n","                  f\"  {r['f1-score']:>7.4f}  {int(r['support']):>6,}{tag}\")\n","    print(f\"  {'Accuracy':<18}  {'':>7}  {'':>7}  {acc:>7.4f}  {len(y_te):>6,}\")\n","\n","    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n","    cv_sc = cross_val_score(knn, X_tr, y_tr, cv=cv, scoring='accuracy', n_jobs=-1)\n","    print(f\"\\n  CV 5-fold : {cv_sc.mean():.4f} ± {cv_sc.std():.4f}\")\n","\n","    # Matriz de confusión\n","    cm      = confusion_matrix(y_te, y_pred)\n","    cm_norm = cm.astype(float) / cm.sum(axis=1, keepdims=True) * 100\n","    sz      = max(10, len(class_names)*0.9)\n","    fig, ax = plt.subplots(figsize=(sz, sz*0.85))\n","    sns.heatmap(cm_norm, annot=True, fmt='.1f', cmap='Blues',\n","                xticklabels=class_names, yticklabels=class_names,\n","                linewidths=0.4, linecolor