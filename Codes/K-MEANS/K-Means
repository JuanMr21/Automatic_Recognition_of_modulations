c=0.6052\n","   UMAP: 15 comp aplicado\n","   UMAP: 15 comp aplicado\n","   UMAP: 15 comp aplicado\n","   UMAP: 15 comp aplicado\n","   UMAP: 15 comp aplicado\n","   UMAP(15) → acc=0.6046\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","███████████████████████████████████████████████████████\n","  🏆  MEJOR CONFIGURACIÓN\n","███████████████████████████████████████████████████████\n","  UMAP(15)      | Ensemble\n","  Reducción : UMAP(15)\n","  Ensemble  : Sí\n","  Accuracy  : 0.6046 ± 0.0053\n","███████████████████████████████████████████████████████\n","\n","───────────────────────────────────────────────────────\n","  ⚙️  Reducción=UMAP(15) | Ensemble=Sí\n","───────────────────────────────────────────────────────\n","   UMAP: 15 comp aplicado\n","   Fold 1: acc=0.6105\n","   UMAP: 15 comp aplicado\n","   Fold 2: acc=0.6086\n","   UMAP: 15 comp aplicado\n","   Fold 3: acc=0.6068\n","   UMAP: 15 comp aplicado\n","   Fold 4: acc=0.6014\n","   UMAP: 15 comp aplicado\n","   Fold 5: acc=0.5959\n","\n","✅ Accuracy media : 0.6046  (60.46%)\n","   Desv. estándar : 0.0053\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1300x1000 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","📋 REPORTE DE CLASIFICACIÓN\n","              precision    recall  f1-score   support\n","\n","        8PSK       0.00      0.00      0.00      1000\n","      AM-DSB       0.64      1.00      0.78      1000\n","      AM-SSB       0.94      1.00      0.97      1000\n","        BPSK       0.68      0.95      0.79      1000\n","       CPFSK       0.54      0.99      0.70      1000\n","        GFSK       0.00      0.00      0.00      1000\n","        PAM4       0.91      0.55      0.69      1000\n","       QAM16       0.26      0.04      0.07      1000\n","       QAM64       0.47      0.89      0.62      1000\n","        QPSK       0.47      0.90      0.62      1000\n","        WBFM       0.56      0.34      0.42      1000\n","\n","    accuracy                           0.60     11000\n","   macro avg       0.50      0.60      0.51     11000\n","weighted avg       0.50      0.60      0.51     11000\n","\n","\n","═══════════════════════════════════════════════════════\n","  📈  RESUMEN FINAL — SNR=18 dB\n","═══════════════════════════════════════════════════════\n","  Features utilizadas : 38\n","  Baseline (v2)       : 49.41%\n","  Mejor configuración : 60.46%\n","  Mejora obtenida     : +11.05 pp\n","═══════════════════════════════════════════════════════\n","✅ Pipeline v3 completado.\n"]}],"source":["# ============================================================\n","# 📡 K-MEANS MEJORADO — RML2016.10a\n","#    v3: Features frecuenciales + fase + UMAP + Ensemble\n","#    Objetivo: superar 49% de accuracy con K-Means\n","# ============================================================\n","\n","# ── INSTALACIÓN DE DEPENDENCIAS ──────────────────────────────\n","# Ejecutar esta celda primero en Colab:\n","# !pip install umap-learn -q\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","import pickle, warnings\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.gridspec as gridspec\n","import seaborn as sns\n","warnings.filterwarnings('ignore')\n","\n","from scipy.stats        import skew, kurtosis, mode\n","from scipy.fft          import fft, fftfreq\n","from scipy.signal       import welch\n","from sklearn.cluster    import KMeans, MiniBatchKMeans\n","from sklearn.decomposition import PCA\n","from sklearn.preprocessing import StandardScaler, RobustScaler\n","from sklearn.metrics    import accuracy_score, confusion_matrix, classification_report\n","from sklearn.model_selection import StratifiedKFold, train_test_split\n","from scipy.optimize     import linear_sum_assignment\n","from collections        import Counter\n","\n","try:\n","    import umap\n","    UMAP_AVAILABLE = True\n","except ImportError:\n","    UMAP_AVAILABLE = False\n","    print(\"⚠️  umap-learn no instalado. Ejecuta: !pip install umap-learn -q\")\n","\n","# ── CONFIGURACIÓN ────────────────────────────────────────────\n","FILE_PATH    = '/content/drive/MyDrive/Seminario/RML2016.10a_dict.pkl'\n","SNR_OBJETIVO = 18\n","N_SPLITS     = 5\n","RANDOM_STATE = 42\n","np.random.seed(RANDOM_STATE)\n","print(f\"✅ Config lista — SNR={SNR_OBJETIVO} dB\")\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  A. CARGA DEL DATASET                                   ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def cargar_dataset(ruta):\n","    with open(ruta, 'rb') as f:\n","        ds = pickle.load(f, encoding='latin1')\n","    mods = sorted(set(k[0] for k in ds.keys()))\n","    snrs = sorted(set(k[1] for k in ds.keys()))\n","    print(f\"📂 Dataset: {len(ds)} entradas | {len(mods)} mods | SNRs: {snrs}\")\n","    return ds, mods, snrs\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  B. EXTRACCIÓN DE FEATURES ENRIQUECIDAS (38 features)   ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def features_temporales(I, Q):\n","    \"\"\"10 features temporales base (versión anterior).\"\"\"\n","    amp = np.sqrt(I**2 + Q**2)\n","    return [\n","        np.std(I),   np.std(Q),\n","        skew(I),     skew(Q),\n","        kurtosis(I), kurtosis(Q),\n","        np.mean(amp), np.std(amp),\n","        kurtosis(amp),\n","        np.mean(np.abs(np.diff(amp))),\n","    ]\n","\n","\n","def features_fase(I, Q):\n","    \"\"\"\n","    8 features de fase instantánea.\n","    Claves para separar 8PSK, BPSK, QPSK (0% con features anteriores).\n","    \"\"\"\n","    fase        = np.arctan2(Q, I)\n","    fase_unwr   = np.unwrap(fase)\n","    fase_dif    = np.diff(fase_unwr)          # frecuencia instantánea\n","    fase_dif2   = np.diff(fase_dif)           # aceleración de fase\n","\n","    return [\n","        np.std(fase),                         # dispersión de fase\n","        kurtosis(fase),                       # forma distribución de fase\n","        np.mean(np.abs(fase_dif)),            # cambio de fase medio\n","        np.std(fase_dif),                     # varianza de frecuencia inst.\n","        kurtosis(fase_dif),                   # curtosis de freq. inst.\n","        np.max(np.abs(fase_dif)),             # máximo cambio de fase\n","        np.std(fase_dif2),                    # varianza de aceleración\n","        np.mean(np.abs(fase_dif) > np.pi/4), # proporción de saltos grandes\n","    ]\n","\n","\n","def features_frecuenciales(I, Q, fs=1.0):\n","    \"\"\"\n","    12 features espectrales via FFT y PSD (Welch).\n","    Separan AM-DSB/SSB, WBFM (0% con features anteriores).\n","    \"\"\"\n","    N    = len(I)\n","    senal_compleja = I + 1j * Q\n","\n","    # FFT de amplitud\n","    amp_fft  = np.abs(fft(senal_compleja))[:N//2]\n","    freqs    = fftfreq(N, d=1/fs)[:N//2]\n","    amp_fft_norm = amp_fft / (np.sum(amp_fft) + 1e-10)\n","\n","    # Momentos espectrales\n","    f_mean   = np.sum(freqs * amp_fft_norm)             # centroide\n","    f_std    = np.sqrt(np.sum(((freqs - f_mean)**2) * amp_fft_norm))\n","    f_kurt   = kurtosis(amp_fft)\n","\n","    # Energía en bandas (baja/media/alta)\n","    tercio   = N // 6\n","    e_baja   = np.sum(amp_fft[:tercio]**2)\n","    e_media  = np.sum(amp_fft[tercio:2*tercio]**2)\n","    e_alta   = np.sum(amp_fft[2*tercio:]**2)\n","    e_total  = e_baja + e_media + e_alta + 1e-10\n","\n","    # Pico espectral y relación señal/banda\n","    pico_idx = np.argmax(amp_fft)\n","    pico_rel = amp_fft[pico_idx] / (np.mean(amp_fft) + 1e-10)\n","\n","    # PSD (Welch) — potencia espectral más robusta\n","    _, psd   = welch(np.abs(senal_compleja), fs=fs, nperseg=32)\n","    psd_norm = psd / (np.sum(psd) + 1e-10)\n","    psd_kurt = kurtosis(psd)\n","    psd_max  = np.max(psd_norm)\n","\n","    return [\n","        f_mean, f_std, f_kurt,                # momentos espectrales\n","        e_baja/e_total,                       # fracción energía baja\n","        e_media/e_total,                      # fracción energía media\n","        e_alta/e_total,                       # fracción energía alta\n","        pico_rel,                             # dominancia del pico\n","        float(pico_idx) / (N//2),             # posición normalizada del pico\n","        psd_kurt,                             # forma del PSD\n","        psd_max,                              # pico normalizado del PSD\n","        np.std(psd_norm),                     # dispersión del PSD\n","        np.sum(psd_norm[:len(psd_norm)//2]),  # energía PSD mitad baja\n","    ]\n","\n","\n","def features_constelacion(I, Q):\n","    \"\"\"\n","    8 features de la constelación I/Q.\n","    Distinguen QAM16/QAM64/PAM4 (mal clasificados antes).\n","    \"\"\"\n","    amp      = np.sqrt(I**2 + Q**2)\n","    amp_norm = amp / (np.mean(amp) + 1e-10)\n","\n","    # Niveles de amplitud distintos (alta varianza → QAM multi-nivel)\n","    hist, _  = np.histogram(amp_norm, bins=8, range=(0, 3))\n","    hist_n   = hist / (np.sum(hist) + 1e-10)\n","    entropia = -np.sum(hist_n * np.log2(hist_n + 1e-10))\n","\n","    # Varianza de los cuadrantes\n","    cuad_vars = []\n","    for si, sq in [( 1, 1),(-1, 1),(-1,-1),( 1,-1)]:\n","        mask = (np.sign(I) == si) & (np.sign(Q) == sq)\n","        if np.sum(mask) > 2:\n","            cuad_vars.append(np.var(amp[mask]))\n","        else:\n","            cuad_vars.append(0.0)\n","\n","    return [\n","        entropia,                             # entropía de niveles de amplitud\n","        np.var(cuad_vars),                    # varianza entre cuadrantes\n","        np.max(amp) / (np.mean(amp) + 1e-10),# razón pico/media\n","        np.percentile(amp, 90) /\n","        (np.percentile(amp, 10) + 1e-10),    # razón P90/P10\n","        np.mean(amp_norm > 1.5),              # fracción de muestras de alta amplitud\n","        np.mean(amp_norm < 0.5),              # fracción de muestras de baja amplitud\n","        np.corrcoef(I, Q)[0, 1],             # correlación I·Q\n","        kurtosis(amp_norm),                   # curtosis amplitud normalizada\n","    ]\n","\n","\n","def extraer_features_completas(dataset, mods, snr):\n","    \"\"\"\n","    Combina las 4 familias de features → 38 features por señal.\n","    \"\"\"\n","    X_list, y_list = [], []\n","    for mod in mods:\n","        if (mod, snr) not in dataset:\n","            continue\n","        for signal in dataset[(mod, snr)]:\n","            I, Q = signal[0], signal[1]\n","            feat = (\n","                features_temporales(I, Q)    +   # 10\n","                features_fase(I, Q)          +   # 8\n","                features_frecuenciales(I, Q) +   # 12\n","                features_constelacion(I, Q)      # 8\n","            )                                    # = 38 features\n","            X_list.append(feat)\n","            y_list.append(mod)\n","\n","    X = np.array(X_list, dtype=np.float32)\n","    y = np.array(y_list)\n","\n","    # Reemplazar NaN/Inf por 0\n","    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)\n","    print(f\"✅ Features: {X.shape} | Clases: {len(np.unique(y))}\")\n","    return X, y\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  C. REDUCCIÓN DIMENSIONAL                               ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def reducir_dimension(X_tr, X_te, metodo='pca', n_comp=15):\n","    \"\"\"\n","    Aplica PCA o UMAP para reducción dimensional.\n","    UMAP preserva estructura no lineal → mejor separación de clústeres.\n","    \"\"\"\n","    if metodo == 'pca':\n","        red = PCA(n_components=n_comp, random_state=RANDOM_STATE)\n","        X_tr_r = red.fit_transform(X_tr)\n","        X_te_r = red.transform(X_te)\n","        var    = red.explained_variance_ratio_.sum() * 100\n","        print(f\"   PCA: {n_comp} comp → {var:.1f}% varianza explicada\")\n","\n","    elif metodo == 'umap' and UMAP_AVAILABLE:\n","        red = umap.UMAP(n_components=n_comp, n_neighbors=30,\n","                        min_dist=0.1, metric='euclidean',\n","                        random_state=RANDOM_STATE)\n","        X_tr_r = red.fit_transform(X_tr)\n","        X_te_r = red.transform(X_te)\n","        print(f\"   UMAP: {n_comp} comp aplicado\")\n","\n","    else:\n","        print(f\"   Sin reducción (o UMAP no disponible)\")\n","        return X_tr, X_te, None\n","\n","    return X_tr_r, X_te_r, red\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  D. MAPEO CLÚSTER → ETIQUETA (MODA)                     ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def mapear_por_moda(train_clusters, y_train, n_mods):\n","    cluster_to_label = {}\n","    for i in range(n_mods):\n","        mask = (train_clusters == i)\n","        if np.any(mask):\n","            val = mode(y_train[mask], keepdims=True)[0][0]\n","            cluster_to_label[i] = int(val)\n","        else:\n","            cluster_to_label[i] = 0\n","    return cluster_to_label\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  E. ENSEMBLE DE K-MEANS                                 ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def ensemble_kmeans(X_tr, X_te, y_tr, n_mods,\n","                    n_modelos=10, n_init_each=20):\n","    \"\"\"\n","    Entrena N modelos K-Means con semillas distintas.\n","    La predicción final es la MODA de todas las predicciones.\n","    Reduce el efecto de mínimos locales.\n","    \"\"\"\n","    todas_preds = []\n","    for seed in range(n_modelos):\n","        km = KMeans(n_clusters=n_mods, n_init=n_init_each,\n","                    random_state=seed, max_iter=500)\n","        tr_cls = km.fit_predict(X_tr)\n","        te_cls = km.predict(X_te)\n","        c2l    = mapear_por_moda(tr_cls, y_tr, n_mods)\n","        y_pred = np.array([c2l[c] for c in te_cls])\n","        todas_preds.append(y_pred)\n","\n","    # Votación por moda entre los N modelos\n","    preds_matrix = np.vstack(todas_preds).T  # (n_test, n_modelos)\n","    y_final = np.array([\n","        mode(fila, keepdims=True)[0][0] for fila in preds_matrix\n","    ])\n","    return y_final\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  F. PIPELINE K-FOLD MEJORADO                            ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def pipeline_mejorado(X, y_num, n_mods,\n","                      metodo_reduccion='pca',   # 'pca' | 'umap' | 'ninguno'\n","                      n_comp=15,\n","                      usar_ensemble=True,\n","                      n_modelos_ensemble=10,\n","                      verbose=True):\n","    \"\"\"\n","    Pipeline completo con:\n","    - RobustScaler (resistente a outliers)\n","    - Reducción dimensional (PCA o UMAP)\n","    - Ensemble de K-Means o K-Means simple\n","    - K-Fold estratificado\n","    \"\"\"\n","    kf = StratifiedKFold(n_splits=N_SPLITS, shuffle=True,\n","                         random_state=RANDOM_STATE)\n","    scores = []\n","    all_y_test, all_y_pred = [], []\n","\n","    label = (f\"Reducción={metodo_reduccion.upper()}({n_comp}) | \"\n","             f\"Ensemble={'Sí' if usar_ensemble else 'No'}\")\n","    if verbose:\n","        print(f\"\\n{'─'*55}\")\n","        print(f\"  ⚙️  {label}\")\n","        print(f\"{'─'*55}\")\n","\n","    for fold, (tr_idx, te_idx) in enumerate(\n","            kf.split(X, y_num), 1):\n","        X_tr, X_te = X[tr_idx], X[te_idx]\n","        y_tr, y_te = y_num[tr_idx], y_num[te_idx]\n","\n","        # Escalado robusto (RobustScaler ignora outliers)\n","        scaler  = RobustScaler()\n","        X_tr_sc = scaler.fit_transform(X_tr)\n","        X_te_sc = scaler.transform(X_te)\n","\n","        # Reducción dimensional\n","        if metodo_reduccion != 'ninguno':\n","            X_tr_f, X_te_f, _ = reducir_dimension(\n","                X_tr_sc, X_te_sc, metodo_reduccion, n_comp)\n","        else:\n","            X_tr_f, X_te_f = X_tr_sc, X_te_sc\n","\n","        # Predicción\n","        if usar_ensemble:\n","            y_pred = ensemble_kmeans(\n","                X_tr_f, X_te_f, y_tr, n_mods,\n","                n_modelos=n_modelos_ensemble)\n","        else:\n","            km     = KMeans(n_clusters=n_mods, n_init=30,\n","                            max_iter=500, random_state=RANDOM_STATE)\n","            tr_cls = km.fit_predict(X_tr_f)\n","            te_cls = km.predict(X_te_f)\n","            c2l    = mapear_por_moda(tr_cls, y_tr, n_mods)\n","            y_pred = np.array([c2l[c] for c in te_cls])\n","\n","        acc = accuracy_score(y_te, y_pred)\n","        scores.append(acc)\n","        all_y_test.extend(y_te)\n","        all_y_pred.extend(y_pred)\n","        if verbose:\n","            print(f\"   Fold {fold}: acc={acc:.4f}\")\n","\n","    media = np.mean(scores)\n","    std   = np.std(scores)\n","    if verbose:\n","        print(f\"\\n✅ Accuracy media : {media:.4f}  ({media*100:.2f}%)\")\n","        print(f\"   Desv. estándar : {std:.4f}\")\n","\n","    return np.array(scores), np.array(all_y_test), np.array(all_y_pred)\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  G. EXPERIMENTO COMPARATIVO DE CONFIGURACIONES          ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def experimento_comparativo(X, y_num, n_mods, mods):\n","    \"\"\"\n","    Compara sistemáticamente todas las combinaciones de:\n","    - Reducción: ninguno / PCA / UMAP\n","    - Ensemble: Sí / No\n","    Devuelve tabla de resultados ordenada.\n","    \"\"\"\n","    configuraciones = [\n","        ('ninguno',  10, False, 'Sin reducción | K-Means simple'),\n","        ('ninguno',  10, True,  'Sin reducción | Ensemble'),\n","        ('pca',      15, False, 'PCA(15)       | K-Means simple'),\n","        ('pca',      15, True,  'PCA(15)       | Ensemble'),\n","        ('pca',      20, True,  'PCA(20)       | Ensemble'),\n","    ]\n","    if UMAP_AVAILABLE:\n","        configuraciones += [\n","            ('umap', 10, False, 'UMAP(10)      | K-Means simple'),\n","            ('umap', 10, True,  'UMAP(10)      | Ensemble'),\n","            ('umap', 15, True,  'UMAP(15)      | Ensemble'),\n","        ]\n","\n","    resultados = []\n","    print(f\"\\n{'█'*60}\")\n","    print(\"  🧪  EXPERIMENTO COMPARATIVO DE CONFIGURACIONES\")\n","    print(f\"{'█'*60}\")\n","\n","    for red, n_c, ens, desc in configuraciones:\n","        scores, _, _ = pipeline_mejorado(\n","            X, y_num, n_mods,\n","            metodo_reduccion=red,\n","            n_comp=n_c,\n","            usar_ensemble=ens,\n","            n_modelos_ensemble=10,\n","            verbose=False\n","        )\n","        media = np.mean(scores)\n","        std   = np.std(scores)\n","        resultados.append({\n","            'descripcion': desc,\n","            'reduccion':   red,\n","            'n_comp':      n_c,\n","            'ensemble':    ens,\n","            'acc_media':   media,\n","            'acc_std':     std,\n","        })\n","        print(f\"  {desc:<38}  acc={media:.4f} ± {std:.4f}\")\n","\n","    resultados.sort(key=lambda x: x['acc_media'], reverse=True)\n","    return resultados\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  H. BARRIDO DE N_COMPONENTES (PCA y UMAP)               ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def sweep_componentes(X, y_num, n_mods, metodo='pca',\n","                      rango=None, usar_ensemble=True):\n","    if rango is None:\n","        rango = [5, 8, 10, 12, 15, 20, 25, 30] if metodo=='pca' \\\n","                else [5, 8, 10, 12, 15]\n","\n","    print(f\"\\n🔎 Barrido n_componentes — {metodo.upper()}\")\n","    xs, accs = [], []\n","    for nc in rango:\n","        scores, _, _ = pipeline_mejorado(\n","            X, y_num, n_mods,\n","            metodo_reduccion=metodo, n_comp=nc,\n","            usar_ensemble=usar_ensemble, verbose=False)\n","        media = np.mean(scores)\n","        xs.append(nc); accs.append(media)\n","        print(f\"   {metodo.upper()}({nc:2d}) → acc={media:.4f}\")\n","    return xs, accs\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  I. VISUALIZACIÓN                                       ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","PALETA = {\n","    'bg': '#0D1B2A', 'blue': '#00C8FF', 'orange': '#FF6B35',\n","    'green': '#39FF14', 'grid': '#1E3A5F', 'text': '#E8F4F8',\n","    'purple': '#B44FED', 'yellow': '#FFD700',\n","}\n","\n","def _base():\n","    plt.rcParams.update({\n","        'figure.facecolor': PALETA['bg'], 'axes.facecolor': PALETA['bg'],\n","        'axes.edgecolor':   PALETA['grid'], 'axes.labelcolor': PALETA['text'],\n","        'xtick.color':      PALETA['text'], 'ytick.color':    PALETA['text'],\n","        'text.color':       PALETA['text'], 'grid.color':     PALETA['grid'],\n","        'grid.linestyle':   '--',           'grid.alpha':     0.5,\n","        'font.family':      'monospace',\n","    })\n","\n","\n","def graficar_comparativo(resultados):\n","    _base()\n","    descs = [r['descripcion'] for r in resultados]\n","    accs  = [r['acc_media']   for r in resultados]\n","    stds  = [r['acc_std']     for r in resultados]\n","    colores = [PALETA['green'] if i == 0 else PALETA['blue']\n","               for i in range(len(resultados))]\n","\n","    fig, ax = plt.subplots(figsize=(13, 5), facecolor=PALETA['bg'])\n","    bars = ax.barh(descs[::-1], accs[::-1],\n","                   xerr=stds[::-1],\n","                   color=colores[::-1],\n","                   edgecolor=PALETA['text'],\n","                   error_kw={'ecolor': PALETA['orange'],\n","                             'capsize': 4, 'lw': 1.5})\n","    for bar, acc in zip(bars, accs[::-1]):\n","        ax.text(acc + 0.005, bar.get_y() + bar.get_height()/2,\n","                f'{acc:.4f}', va='center', fontsize=10,\n","                color=PALETA['text'], fontweight='bold')\n","    # Línea de baseline (v2)\n","    ax.axvline(0.49, color=PALETA['orange'], lw=2,\n","               linestyle='--', label='Baseline v2 (49%)')\n","    ax.set_xlabel('Accuracy media (K-Fold)', fontsize=11)\n","    ax.set_title('Comparativa de Configuraciones — K-Means Mejorado',\n","                 fontsize=13, fontweight='bold', color=PALETA['blue'])\n","    ax.legend(fontsize=9, framealpha=0.3,\n","              facecolor=PALETA['bg'], edgecolor=PALETA['grid'])\n","    ax.set_xlim(0, min(1.0, max(accs) + 0.08))\n","    ax.grid(axis='x')\n","    plt.tight_layout(); plt.show()\n","\n","\n","def graficar_sweep_comp(xs, accs, metodo):\n","    _base()\n","    fig, ax = plt.subplots(figsize=(8, 4), facecolor=PALETA['bg'])\n","    ax.plot(xs, accs, color=PALETA['blue'], lw=2.5,\n","            marker='o', markersize=9,\n","            markerfacecolor=PALETA['orange'],\n","            markeredgecolor=PALETA['text'])\n","    idx_max = int(np.argmax(accs))\n","    ax.scatter([xs[idx_max]], [accs[idx_max]], s=200,\n","               color=PALETA['green'], zorder=5,\n","               label=f\"Mejor: n={xs[idx_max]} → {accs[idx_max]:.4f}\")\n","    ax.axhline(0.49, color=PALETA['orange'], lw=1.5,\n","               linestyle='--', label='Baseline v2 (49%)')\n","    ax.set_title(f'Barrido N° Componentes — {metodo.upper()}',\n","                 fontsize=12, fontweight='bold', color=PALETA['blue'])\n","    ax.set_xlabel('N° Componentes'); ax.set_ylabel('Accuracy')\n","    ax.legend(fontsize=9, framealpha=0.3,\n","              facecolor=PALETA['bg'], edgecolor=PALETA['grid'])\n","    ax.grid(True); plt.tight_layout(); plt.show()\n","\n","\n","def graficar_confusion(y_true, y_pred, mods, titulo=''):\n","    _base()\n","    clases = sorted(np.unique(np.concatenate([y_true, y_pred])))\n","    nombres = [mods[i] for i in clases if i < len(mods)]\n","    cm      = confusion_matrix(y_true, y_pred, labels=clases)\n","    cm_norm = cm.astype(float) / np.maximum(cm.sum(axis=1, keepdims=True), 1)\n","\n","    fig, ax = plt.subplots(figsize=(13, 10), facecolor=PALETA['bg'])\n","    sns.heatmap(cm_norm, annot=True, fmt='.2f', cmap='Blues',\n","                xticklabels=nombres, yticklabels=nombres,\n","                ax=ax, linewidths=0.4, linecolor='#0D1B2A',\n","                cbar_kws={'shrink': 0.8})\n","    ax.set_title(f'Matriz de Confusión — {titulo}',\n","                 fontsize=13, fontweight='bold', color=PALETA['blue'])\n","    ax.set_xlabel('Predicción'); ax.set_ylabel('Real')\n","    plt.xticks(rotation=45, ha='right')\n","    plt.tight_layout(); plt.show()\n","\n","    print(\"\\n📋 REPORTE DE CLASIFICACIÓN\")\n","    print(classification_report(y_true, y_pred,\n","                                labels=clases, target_names=nombres,\n","                                zero_division=0))\n","\n","\n","def graficar_importancia_features():\n","    \"\"\"Muestra las familias de features y su rol.\"\"\"\n","    _base()\n","    familias  = ['Temporales\\n(10)', 'Fase\\n(8)',\n","                 'Frecuenciales\\n(12)', 'Constelación\\n(8)']\n","    colores   = [PALETA['blue'], PALETA['purple'],\n","                 PALETA['green'], PALETA['yellow']]\n","    clases_ok = ['CPFSK\\nGFSK', '8PSK\\nBPSK\\nQPSK',\n","                 'AM-DSB\\nAM-SSB\\nWBFM', 'QAM16\\nQAM64\\nPAM4']\n","\n","    fig, axes = plt.subplots(1, 2, figsize=(14, 5),\n","                              facecolor=PALETA['bg'])\n","    # Donut de familias\n","    ax = axes[0]\n","    sizes = [10, 8, 12, 8]\n","    wedges, texts, autotexts = ax.pie(\n","        sizes, labels=familias, colors=colores,\n","        autopct='%1.0f%%', startangle=90,\n","        wedgeprops={'edgecolor': PALETA['bg'], 'linewidth': 2},\n","        textprops={'color': PALETA['text'], 'fontsize': 10})\n","    for at in autotexts:\n","        at.set_color(PALETA['bg']); at.set_fontweight('bold')\n","    # Agujero central\n","    centre_circle = plt.Circle((0,0), 0.55, fc=PALETA['bg'])\n","    ax.add_patch(centre_circle)\n","    ax.set_title('Distribución de Features (38 total)',\n","                 fontsize=12, color=PALETA['blue'], fontweight='bold')\n","\n","    # Tabla de utilidad\n","    ax2 = axes[1]\n","    ax2.axis('off')\n","    tabla_data = list(zip(familias, clases_ok))\n","    tabla = ax2.table(\n","        cellText=tabla_data,\n","        colLabels=['Familia de features', 'Clases que separa mejor'],\n","        cellLoc='center', loc='center',\n","        bbox=[0, 0.1, 1, 0.85]\n","    )\n","    tabla.auto_set_font_size(False); tabla.set_fontsize(10)\n","    for (row, col), cell in tabla.get_celld().items():\n","        cell.set_facecolor(PALETA['grid'] if row == 0 else PALETA['bg'])\n","        cell.set_edgecolor(PALETA['grid'])\n","        cell.set_text_props(color=PALETA['blue'] if row == 0\n","                           else PALETA['text'])\n","    ax2.set_title('Utilidad por Familia',\n","                  fontsize=12, color=PALETA['blue'], fontweight='bold')\n","    plt.tight_layout(); plt.show()\n","\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  J. MAIN — EJECUCIÓN COMPLETA                           ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","# ── Carga ─────────────────────────────────────────────────────\n","dataset, mods, snrs_disp = cargar_dataset(FILE_PATH)\n","if SNR_OBJETIVO not in snrs_disp:\n","    raise ValueError(f\"SNR {SNR_OBJETIVO} no en {snrs_disp}\")\n","\n","# ── Features enriquecidas (38) ────────────────────────────────\n","print(\"\\n⚙️  Extrayendo 38 features por señal…\")\n","X, y = extraer_features_completas(dataset, mods, SNR_OBJETIVO)\n","\n","label_encoder = {mod: i for i, mod in enumerate(mods)}\n","y_num         = np.array([label_encoder[v] for v in y])\n","n_mods        = len(mods)\n","\n","# Diagrama de features\n","graficar_importancia_features()\n","\n","# ── 1. Experimento comparativo de todas las configuraciones ───\n","resultados = experimento_comparativo(X, y_num, n_mods, mods)\n","graficar_comparativo(resultados)\n","\n","# ── 2. Barrido de n_componentes (PCA) ────────────────────────\n","xs_pca, accs_pca = sweep_componentes(\n","    X, y_num, n_mods, metodo='pca',\n","    rango=[5, 8, 10, 12, 15, 20, 25, 30],\n","    usar_ensemble=True)\n","graficar_sweep_comp(xs_pca, accs_pca, 'PCA')\n","\n","# ── 3. Barrido UMAP (si disponible) ──────────────────────────\n","if UMAP_AVAILABLE:\n","    xs_umap, accs_umap = sweep_componentes(\n","        X, y_num, n_mods, metodo='umap',\n","        rango=[5, 8, 10, 12, 15],\n","        usar_ensemble=True)\n","    graficar_sweep_comp(xs_umap, accs_umap, 'UMAP')\n","\n","# ── 4. MEJOR CONFIGURACIÓN → Resultado final detallado ───────\n","mejor = resultados[0]\n","print(f\"\\n{'█'*55}\")\n","print(f\"  🏆  MEJOR CONFIGURACIÓN\")\n","print(f\"{'█'*55}\")\n","print(f\"  {mejor['descripcion']}\")\n","print(f\"  Reducción : {mejor['reduccion'].upper()}({mejor['n_comp']})\")\n","print(f\"  Ensemble  : {'Sí' if mejor['ensemble'] else 'No'}\")\n","print(f\"  Accuracy  : {mejor['acc_media']:.4f} ± {mejor['acc_std']:.4f}\")\n","print(f\"{'█'*55}\")\n","\n","scores_f, y_test_f, y_pred_f = pipeline_mejorado(\n","    X, y_num, n_mods,\n","    metodo_reduccion=mejor['reduccion'],\n","    n_comp=mejor['n_comp'],\n","    usar_ensemble=mejor['ensemble'],\n","    n_modelos_ensemble=15,    # más modelos para el resultado final\n","    verbose=True\n",")\n","\n","graficar_confusion(y_test_f, y_pred_f, mods,\n","                   titulo=mejor['descripcion'])\n","\n","# ╔══════════════════════════════════════════════════════════╗\n","# ║  I-bis. MATRIZ DE CONFUSIÓN BÁSICA (azul estándar)      ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","def graficar_confusion_basica(y_true, y_pred, mods, titulo=''):\n","    \"\"\"\n","    Matriz de confusión normalizada con paleta azul estándar.\n","    Fondo blanco, sin tema personalizado.\n","    \"\"\"\n","    clases  = sorted(np.unique(np.concatenate([y_true, y_pred])))\n","    nombres = [mods[i] for i in clases if i < len(mods)]\n","    cm      = confusion_matrix(y_true, y_pred, labels=clases)\n","    cm_norm = cm.astype(float) / np.maximum(cm.sum(axis=1, keepdims=True), 1)\n","\n","    fig, ax = plt.subplots(figsize=(12, 9))\n","    im = ax.imshow(cm_norm, interpolation='nearest', cmap='Blues',\n","                   vmin=0, vmax=1)\n","    fig.colorbar(im, ax=ax, shrink=0.8, label='Proporción')\n","\n","    # Etiquetas en los ejes\n","    ax.set_xticks(np.arange(len(nombres)))\n","    ax.set_yticks(np.arange(len(nombres)))\n","    ax.set_xticklabels(nombres, rotation=45, ha='right', fontsize=10)\n","    ax.set_yticklabels(nombres, fontsize=10)\n","\n","    # Anotaciones con valor numérico en cada celda\n","    thresh = cm_norm.max() / 2.0\n","    for i in range(len(nombres)):\n","        for j in range(len(nombres)):\n","            valor = cm_norm[i, j]\n","            color = 'white' if valor > thresh else 'black'\n","            ax.text(j, i, f'{valor:.2f}',\n","                    ha='center', va='center',\n","                    fontsize=8, color=color, fontweight='bold')\n","\n","    ax.set_title(f'Matriz de Confusión — {titulo}', fontsize=13, pad=15)\n","    ax.set_xlabel('Predicción', fontsize=11)\n","    ax.set_ylabel('Real', fontsize=11)\n","    plt.tight_layout()\n","    plt.show()\n","\n","    print(\"\\n📋 REPORTE DE CLASIFICACIÓN\")\n","    print(classification_report(y_true, y_pred,\n","                                labels=clases, target_names=nombres,\n","                                zero_division=0))\n","\n","# Resumen final\n","print(f\"\\n{'═'*55}\")\n","print(f\"  📈  RESUMEN FINAL — SNR={SNR_OBJETIVO} dB\")\n","print(f\"{'═'*55}\")\n","print(f\"  Features utilizadas : 38\")\n","print(f\"  Baseline (v2)       : 49.41%\")\n","print(f\"  Mejor configuración : {mejor['acc_media']*100:.2f}%\")\n","delta = (mejor['acc_media'] - 0.4941) * 100\n","print(f\"  Mejora obtenida     : +{delta:.2f} pp\")\n","print(f\"{'═'*55}\")\n","print(\"✅ Pipeline v3 completado.\")"]}],"metadata":{"accelerator":"GPU","colab":{"gpuType":"T4","provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}