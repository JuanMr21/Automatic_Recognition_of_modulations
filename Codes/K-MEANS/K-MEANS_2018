 450\n","       Mod_4       1.00      0.98      0.99       450\n","       Mod_5       0.29      0.30      0.29       450\n","       Mod_6       0.32      0.43      0.37       450\n","       Mod_7       0.31      0.21      0.25       450\n","       Mod_8       0.51      0.63      0.56       450\n","       Mod_9       0.52      0.58      0.55       450\n","      Mod_10       0.20      0.12      0.15       450\n","      Mod_11       0.22      0.33      0.26       450\n","      Mod_12       0.29      0.40      0.34       450\n","      Mod_13       0.20      0.21      0.21       450\n","      Mod_14       0.34      0.17      0.23       450\n","      Mod_15       0.19      0.12      0.15       450\n","      Mod_16       0.29      0.26      0.28       450\n","      Mod_17       0.53      0.68      0.59       450\n","      Mod_18       0.56      0.40      0.46       450\n","      Mod_19       0.50      0.60      0.55       450\n","      Mod_20       0.51      0.42      0.46       450\n","      Mod_21       1.00      1.00      1.00       450\n","      Mod_22       1.00      1.00      1.00       450\n","      Mod_23       0.88      0.88      0.88       450\n","\n","    accuracy                           0.49     10800\n","   macro avg       0.49      0.49      0.48     10800\n","weighted avg       0.49      0.49      0.48     10800\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1400 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1400 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# ============================================================\n","# K-MEANS RadioML - Versión estadística estable\n","# SNR exacta + PCA opcional + sobre-segmentación\n","# ============================================================\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","import h5py\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import warnings\n","import seaborn as sns\n","\n","from sklearn.preprocessing import StandardScaler, PowerTransformer\n","from sklearn.decomposition import PCA\n","from sklearn.cluster import MiniBatchKMeans\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import confusion_matrix, accuracy_score, classification_report\n","\n","warnings.filterwarnings(\"ignore\")\n","\n","\n","# ============================================================\n","# 1. CONFIGURACIÓN\n","# ============================================================\n","\n","FILE_PATH = \"/content/drive/MyDrive/Seminario/Modulation_data.hdf5\"\n","\n","# SNR exacta, NO umbral\n","SNR_DB = 30\n","\n","# PCA opcional\n","USE_PCA = False\n","PCA_COMPONENTS = 24\n","\n","# Muestras por modulación\n","MAX_SAMPLES_PER_CLASS = 1500\n","\n","# Train/Test\n","TEST_SIZE = 0.30\n","RANDOM_STATE = 42\n","\n","# Sobre-segmentación\n","# Si hay 24 modulaciones: 24 * 10 = 240 clusters\n","CLUSTER_MULTIPLIER = 15\n","\n","# K-Means\n","BATCH_SIZE = 512\n","MAX_ITER = 700\n","N_INIT = 50\n","\n","\n","# ============================================================\n","# 2. CARGA LIGERA DE ETIQUETAS Y SNR\n","# ============================================================\n","\n","def load_labels_and_snr(path):\n","    with h5py.File(path, \"r\") as f:\n","        print(\"Llaves del archivo:\", list(f.keys()))\n","\n","        Y = np.array(f[\"Y\"])\n","        Z = np.array(f[\"Z\"]).squeeze()\n","\n","        if Y.ndim == 2:\n","            y = np.argmax(Y, axis=1)\n","        else:\n","            y = Y.squeeze()\n","\n","        modulation_names = None\n","        for key in [\"classes\", \"mods\", \"modulations\", \"labels\", \"modulation_names\"]:\n","            if key in f.keys():\n","                raw = np.array(f[key])\n","                modulation_names = [\n","                    item.decode(\"utf-8\") if isinstance(item, bytes) else str(item)\n","                    for item in raw\n","                ]\n","                break\n","\n","        if modulation_names is None:\n","            modulation_names = [f\"Mod_{i}\" for i in np.unique(y)]\n","\n","        print(\"Forma X:\", f[\"X\"].shape)\n","        print(\"Forma Y:\", Y.shape)\n","        print(\"Forma Z:\", Z.shape)\n","\n","    return y.astype(np.int64), Z, modulation_names\n","\n","\n","y_all, snr_all, modulation_names = load_labels_and_snr(FILE_PATH)\n","\n","print(\"\\nSNR disponibles:\", np.unique(snr_all))\n","print(\"Número de modulaciones:\", len(np.unique(y_all)))\n","\n","\n","# ============================================================\n","# 3. FILTRAR POR SNR EXACTA Y BALANCEAR\n","# ============================================================\n","\n","def get_balanced_indices_by_snr(y, snr, snr_value, max_per_class, random_state=42):\n","    rng = np.random.default_rng(random_state)\n","\n","    # SNR exacta\n","    snr_idx = np.where(snr == snr_value)[0]\n","\n","    if len(snr_idx) == 0:\n","        raise ValueError(\n","            f\"No existen muestras con SNR = {snr_value} dB. \"\n","            f\"SNR disponibles: {np.unique(snr)}\"\n","        )\n","\n","    y_snr = y[snr_idx]\n","    selected = []\n","\n","    for cls in np.unique(y_snr):\n","        cls_indices = snr_idx[y_snr == cls]\n","\n","        if len(cls_indices) > max_per_class:\n","            cls_indices = rng.choice(\n","                cls_indices,\n","                size=max_per_class,\n","                replace=False\n","            )\n","\n","        selected.extend(cls_indices)\n","\n","    selected = np.array(selected, dtype=np.int64)\n","    rng.shuffle(selected)\n","\n","    return selected\n","\n","\n","selected_idx = get_balanced_indices_by_snr(\n","    y_all,\n","    snr_all,\n","    SNR_DB,\n","    MAX_SAMPLES_PER_CLASS,\n","    RANDOM_STATE\n",")\n","\n","print(f\"\\nMuestras seleccionadas con SNR exacta = {SNR_DB} dB:\", len(selected_idx))\n","\n","\n","# ============================================================\n","# 4. CARGAR SOLO LAS MUESTRAS SELECCIONADAS\n","# ============================================================\n","\n","def load_selected_X_from_file(path, indices):\n","    indices = np.array(indices, dtype=np.int64)\n","    sorted_indices = np.sort(indices)\n","\n","    with h5py.File(path, \"r\") as f:\n","        X_sorted = np.array(f[\"X\"][sorted_indices], dtype=np.float32)\n","\n","    position = np.argsort(indices)\n","    inverse_position = np.argsort(position)\n","\n","    return X_sorted[inverse_position].astype(np.float32)\n","\n","\n","X = load_selected_X_from_file(FILE_PATH, selected_idx)\n","y = y_all[selected_idx]\n","\n","print(\"Forma X cargada:\", X.shape)\n","print(\"Forma y:\", y.shape)\n","\n","\n","# ============================================================\n","# 5. NORMALIZAR FORMA I/Q\n","# ============================================================\n","\n","def normalize_iq_shape(X):\n","    if X.ndim != 3:\n","        raise ValueError(f\"X debe tener 3 dimensiones. Forma recibida: {X.shape}\")\n","\n","    if X.shape[1] == 2:\n","        X = np.transpose(X, (0, 2, 1))\n","    elif X.shape[2] == 2:\n","        pass\n","    else:\n","        raise ValueError(f\"No se detectó la dimensión I/Q. Forma: {X.shape}\")\n","\n","    return X.astype(np.float32)\n","\n","\n","X = normalize_iq_shape(X)\n","print(\"Forma X normalizada:\", X.shape)\n","\n","\n","# ============================================================\n","# 6. EXTRACCIÓN ESTADÍSTICA AVANZADA\n","# ============================================================\n","\n","def extract_advanced_iq_features(X):\n","    eps = 1e-12\n","\n","    I = X[:, :, 0].astype(np.float32)\n","    Q = X[:, :, 1].astype(np.float32)\n","\n","    z = I + 1j * Q\n","\n","    # Normalización por muestra\n","    z = z - np.mean(z, axis=1, keepdims=True)\n","    z = z / (np.sqrt(np.mean(np.abs(z) ** 2, axis=1, keepdims=True)) + eps)\n","\n","    I = np.real(z).astype(np.float32)\n","    Q = np.imag(z).astype(np.float32)\n","\n","    amp = np.abs(z).astype(np.float32)\n","    phase = np.angle(z).astype(np.float32)\n","    power = amp ** 2\n","\n","    phase_unwrapped = np.unwrap(phase, axis=1)\n","    inst_freq = np.diff(phase_unwrapped, axis=1).astype(np.float32)\n","\n","    features = []\n","\n","    # Estadísticas básicas\n","    signals = [I, Q, amp, power, inst_freq]\n","\n","    for s in signals:\n","        features.append(np.mean(s, axis=1))\n","        features.append(np.std(s, axis=1))\n","        features.append(np.var(s, axis=1))\n","        features.append(np.max(s, axis=1))\n","        features.append(np.min(s, axis=1))\n","        features.append(np.median(s, axis=1))\n","        features.append(np.percentile(s, 25, axis=1))\n","        features.append(np.percentile(s, 75, axis=1))\n","\n","    # Relación I/Q\n","    features.append(np.mean(I * Q, axis=1))\n","    features.append(np.std(I * Q, axis=1))\n","    features.append(np.mean(I ** 2 - Q ** 2, axis=1))\n","    features.append(np.mean(I ** 2 + Q ** 2, axis=1))\n","    features.append(np.mean(np.abs(I - Q), axis=1))\n","    features.append(np.mean(np.abs(I + Q), axis=1))\n","\n","    # Momentos complejos\n","    m20 = np.mean(z ** 2, axis=1)\n","    m21 = np.mean(np.abs(z) ** 2, axis=1)\n","    m40 = np.mean(z ** 4, axis=1)\n","    m42 = np.mean(np.abs(z) ** 4, axis=1)\n","    m60 = np.mean(z ** 6, axis=1)\n","    m63 = np.mean(np.abs(z) ** 6, axis=1)\n","\n","    for m in [m20, m40, m60]:\n","        features.append(np.real(m))\n","        features.append(np.imag(m))\n","        features.append(np.abs(m))\n","\n","    features.append(np.real(m21))\n","    features.append(np.real(m42))\n","    features.append(np.real(m63))\n","\n","    # Cumulantes\n","    c40 = m40 - 3 * (m20 ** 2)\n","    c42 = m42 - np.abs(m20) ** 2 - 2 * (m21 ** 2)\n","    c60 = m60 - 15 * m40 * m20 + 30 * (m20 ** 3)\n","\n","    features.append(np.real(c40))\n","    features.append(np.imag(c40))\n","    features.append(np.abs(c40))\n","\n","    features.append(np.real(c42))\n","    features.append(np.abs(c42))\n","\n","    features.append(np.real(c60))\n","    features.append(np.imag(c60))\n","    features.append(np.abs(c60))\n","\n","    features.append(np.abs(c40) / (np.abs(m21) ** 2 + eps))\n","    features.append(np.abs(c42) / (np.abs(m21) ** 2 + eps))\n","    features.append(np.abs(c60) / (np.abs(m21) ** 3 + eps))\n","\n","    # Espectro\n","    fft_z = np.fft.fftshift(np.fft.fft(z, axis=1), axes=1)\n","    spectrum = np.abs(fft_z).astype(np.float32)\n","    spectrum_power = spectrum ** 2\n","\n","    spectrum_power_norm = spectrum_power / (\n","        np.sum(spectrum_power, axis=1, keepdims=True) + eps\n","    )\n","\n","    freqs = np.linspace(-0.5, 0.5, X.shape[1]).astype(np.float32)\n","\n","    spectral_centroid = np.sum(freqs * spectrum_power_norm, axis=1)\n","    spectral_bandwidth = np.sqrt(\n","        np.sum(((freqs - spectral_centroid[:, None]) ** 2) * spectrum_power_norm, axis=1)\n","    )\n","\n","    spectral_entropy = -np.sum(\n","        spectrum_power_norm * np.log2(spectrum_power_norm + eps),\n","        axis=1\n","    )\n","\n","    features.append(np.mean(spectrum, axis=1))\n","    features.append(np.std(spectrum, axis=1))\n","    features.append(np.max(spectrum, axis=1))\n","    features.append(np.median(spectrum, axis=1))\n","    features.append(spectral_centroid)\n","    features.append(spectral_bandwidth)\n","    features.append(spectral_entropy)\n","\n","    X_features = np.vstack(features).T.astype(np.float32)\n","\n","    X_features = np.nan_to_num(\n","        X_features,\n","        nan=0.0,\n","        posinf=0.0,\n","        neginf=0.0\n","    ).astype(np.float32)\n","\n","    return X_features\n","\n","\n","print(\"\\nExtrayendo características estadísticas avanzadas...\")\n","X_features = extract_advanced_iq_features(X)\n","\n","print(\"Forma de características:\", X_features.shape)\n","\n","del X\n","\n","\n","# ============================================================\n","# 7. TRAIN / TEST\n","# ============================================================\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X_features,\n","    y,\n","    test_size=TEST_SIZE,\n","    random_state=RANDOM_STATE,\n","    stratify=y\n",")\n","\n","del X_features\n","\n","print(\"\\nTrain:\", X_train.shape)\n","print(\"Test:\", X_test.shape)\n","\n","\n","# ============================================================\n","# 8. PREPROCESAMIENTO\n","# ============================================================\n","\n","scaler = StandardScaler()\n","\n","X_train = scaler.fit_transform(X_train).astype(np.float32)\n","X_test = scaler.transform(X_test).astype(np.float32)\n","\n","power_transformer = PowerTransformer(method=\"yeo-johnson\", standardize=True)\n","\n","X_train = power_transformer.fit_transform(X_train).astype(np.float32)\n","X_test = power_transformer.transform(X_test).astype(np.float32)\n","\n","if USE_PCA:\n","    n_components = min(PCA_COMPONENTS, X_train.shape[1], X_train.shape[0] - 1)\n","\n","    pca = PCA(\n","        n_components=n_components,\n","        whiten=True,\n","        random_state=RANDOM_STATE\n","    )\n","\n","    X_train = pca.fit_transform(X_train).astype(np.float32)\n","    X_test = pca.transform(X_test).astype(np.float32)\n","\n","    print(\"\\nPCA activado\")\n","    print(\"Componentes PCA:\", n_components)\n","    print(\"Varianza explicada:\", np.sum(pca.explained_variance_ratio_))\n","else:\n","    n_components = \"No usado\"\n","    print(\"\\nPCA desactivado\")\n","\n","print(\"Forma final train:\", X_train.shape)\n","print(\"Forma final test:\", X_test.shape)\n","\n","\n","# ============================================================\n","# 9. K-MEANS CON SOBRE-SEGMENTACIÓN\n","# ============================================================\n","\n","classes = np.unique(y)\n","n_modulations = len(classes)\n","\n","n_clusters = n_modulations * CLUSTER_MULTIPLIER\n","\n","print(\"\\nNúmero real de modulaciones:\", n_modulations)\n","print(\"Clusters usados por K-Means:\", n_clusters)\n","\n","kmeans = MiniBatchKMeans(\n","    n_clusters=n_clusters,\n","    init=\"k-means++\",\n","    random_state=RANDOM_STATE,\n","    batch_size=BATCH_SIZE,\n","    n_init=N_INIT,\n","    max_iter=MAX_ITER,\n","    reassignment_ratio=0.001\n",")\n","\n","print(\"\\nEntrenando K-Means...\")\n","kmeans.fit(X_train)\n","\n","train_clusters = kmeans.predict(X_train)\n","test_clusters = kmeans.predict(X_test)\n","\n","\n","# ============================================================\n","# 10. MAPEO CLUSTER -> MODULACIÓN\n","# ============================================================\n","\n","def map_many_clusters_to_labels(y_true, clusters):\n","    mapping = {}\n","\n","    for cluster in np.unique(clusters):\n","        idx = np.where(clusters == cluster)[0]\n","\n","        if len(idx) == 0:\n","            continue\n","\n","        labels_inside = y_true[idx]\n","        majority_label = np.bincount(labels_inside).argmax()\n","\n","        mapping[cluster] = majority_label\n","\n","    return mapping\n","\n","\n","cluster_to_label = map_many_clusters_to_labels(y_train, train_clusters)\n","\n","fallback_label = classes[0]\n","\n","y_pred = np.array([\n","    cluster_to_label.get(cluster, fallback_label)\n","    for cluster in test_clusters\n","])\n","\n","\n","# ============================================================\n","# 11. EVALUACIÓN\n","# ============================================================\n","\n","acc = accuracy_score(y_test, y_pred)\n","\n","target_names = [\n","    modulation_names[i] if i < len(modulation_names) else f\"Mod_{i}\"\n","    for i in classes\n","]\n","\n","print(\"\\n===================================================\")\n","print(f\"RESULTADO K-MEANS - SNR = {SNR_DB} dB\")\n","print(\"===================================================\")\n","print(f\"Precisión final: {acc * 100:.2f}%\")\n","print(f\"Modulaciones reales: {n_modulations}\")\n","print(f\"Clusters usados: {n_clusters}\")\n","print(f\"Clusters por modulación: {CLUSTER_MULTIPLIER}\")\n","print(f\"PCA activado: {USE_PCA}\")\n","print(f\"Componentes PCA: {n_components}\")\n","\n","print(\"\\nReporte de clasificación:\")\n","print(classification_report(\n","    y_test,\n","    y_pred,\n","    labels=classes,\n","    target_names=target_names,\n","    zero_division=0\n","))\n","\n","\n","# ============================================================\n","# 12. MATRIZ DE CONFUSIÓN\n","# ============================================================\n","\n","clases_presentes = [classes[i] for i in np.unique(np.concatenate((y_test, y_pred)))]\n","\n","# 2. Calcular la matriz\n","cm = confusion_matrix(y_test, y_pred)\n","\n","# 3. Visualización con Seaborn\n","plt.figure(figsize=(16, 14))\n","\n","sns.heatmap(\n","    cm,\n","    annot=True,           # Agrega los números en las celdas\n","    fmt='d',              # Formato de enteros (evita notación científica)\n","    cmap='Blues',         # Escala de colores azules\n","    xticklabels=clases_presentes,\n","    yticklabels=clases_presentes,\n","    linewidths=0.5,       # Separación sutil entre celdas\n","    square=True,          # Forzar celdas cuadradas para mejor estética\n","    cbar_kws={\"shrink\": .8} # Ajustar el tamaño de la barra de color\n",")\n","\n","# 4. Ajustes de etiquetas y títulos\n","plt.title(f\"Matriz de confusión - K-Means - SNR = {SNR_DB} dB\", fontsize=16)\n","plt.xlabel(\"Predicción\", fontsize=12)\n","plt.ylabel(\"Etiqueta real\", fontsize=12)\n","\n","# Rotar etiquetas para que no se amontonen\n","plt.xticks(rotation=45, ha=\"right\")\n","plt.yticks(rotation=0)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# ============================================================\n","# 13. MATRIZ NORMALIZADA\n","# ============================================================\n","\n","cm_norm = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]\n","\n","plt.figure(figsize=(16, 14))\n","\n","sns.heatmap(\n","    cm_norm,\n","    annot=True,\n","    fmt='.2f',            # Dos decimales para la normalización\n","    cmap='Blues',\n","    xticklabels=target_names,\n","    yticklabels=target_names,\n","    linewidths=0.5,\n","    square=True,\n","    cbar_kws={\"shrink\": .8}\n",")\n","\n","plt.title(f\"Matriz de Confusión Normalizada - K-Means - SNR = {SNR_DB} dB\", fontsize=16)\n","plt.xlabel(\"Predicción\", fontsize=12)\n","plt.ylabel(\"Etiqueta real\", fontsize=12)\n","plt.xticks(rotation=45, ha=\"right\")\n","\n","plt.tight_layout()\n","plt.show()"]}],"metadata":{"colab":{"provenance":[],"gpuType":"T4"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"},"accelerator":"GPU"},"nbformat":4,"nbformat_minor":0}