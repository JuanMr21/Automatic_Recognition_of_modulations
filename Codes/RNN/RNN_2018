{"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":546},"executionInfo":{"elapsed":1669085,"status":"ok","timestamp":1778631661434,"user":{"displayName":"Valeria Cerón","userId":"08334758920951280770"},"user_tz":300},"id":"K-uCabmfLe2l","outputId":"644e3f49-8140-4045-9407-8c09cc77c0c6"},"outputs":[{"name":"stdout","output_type":"stream","text":["Cargando y procesando señales...\n","Entrenando RNN...\n","Epoch 20/80 | Loss: 0.4007\n","Epoch 40/80 | Loss: 0.2172\n","Epoch 60/80 | Loss: 0.1297\n","Epoch 80/80 | Loss: 0.1106\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1200x400 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","✅ PROCESO COMPLETADO. PRECISIÓN FINAL: 93.83%\n"]}],"source":["import numpy as np, h5py, gc, warnings\n","import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","from torch.utils.data import DataLoader, TensorDataset\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import accuracy_score, confusion_matrix, ConfusionMatrixDisplay\n","import matplotlib.pyplot as plt\n","\n","warnings.filterwarnings(\"ignore\")\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","\n","# --- CONFIGURACIÓN ---\n","SNR_TARGET   = 30\n","MAX_MUESTRAS = 1500\n","SEQ_LEN      = 128\n","DOWNSAMPLE   = 2\n","FILE_PATH    = '/content/drive/MyDrive/Seminario/Modulation_data.hdf5'\n","\n","# --- 1. PREPROCESAMIENTO ---\n","def preprocess_rf_v3(chunk):\n","    I = chunk[:, ::DOWNSAMPLE, 0].astype(np.float32)\n","    Q = chunk[:, ::DOWNSAMPLE, 1].astype(np.float32)\n","    std = np.std(I + 1j*Q, axis=1, keepdims=True) + 1e-8\n","    I, Q = I/std, Q/std\n","    mag = np.sqrt(I**2 + Q**2)\n","    phase = np.arctan2(Q, I)\n","    d_phase = np.diff(phase, axis=1, prepend=0)\n","    return np.stack([I, Q, mag, d_phase], axis=-1)\n","\n","# --- 2. CARGA DE DATOS ---\n","print(\"Cargando y procesando señales...\")\n","with h5py.File(FILE_PATH, 'r') as f:\n","    Z = f['Z'][:, 0]\n","    Y_raw = f['Y'][()]\n","    mask = (Z == SNR_TARGET)\n","    classes_names = [str(i) for i in range(Y_raw.shape[1])] # Nombres genéricos de clases\n","\n","    indices = []\n","    for c in range(Y_raw.shape[1]):\n","        idx = np.where(mask & (np.argmax(Y_raw, axis=1) == c))[0]\n","        if len(idx) > 0: indices.append(idx[:MAX_MUESTRAS])\n","\n","    sel = np.sort(np.concatenate(indices))\n","    X_raw = f['X'][sel.tolist()]\n","    y_data = np.argmax(Y_raw[sel], axis=1)\n","\n","X_processed = preprocess_rf_v3(X_raw)\n","X_train, X_test, y_train, y_test = train_test_split(X_processed, y_data, test_size=0.2, stratify=y_data, random_state=42)\n","\n","train_loader = DataLoader(TensorDataset(torch.from_numpy(X_train).float(), torch.from_numpy(y_train).long()), batch_size=64, shuffle=True)\n","test_loader = DataLoader(TensorDataset(torch.from_numpy(X_test).float(), torch.from_numpy(y_test).long()), batch_size=64)\n","\n","# --- 3. MODELO RNN (GRU) ---\n","class RadioNet(nn.Module):\n","    def __init__(self, n_classes):\n","        super().__init__()\n","        self.gru = nn.GRU(4, 128, num_layers=2, batch_first=True, bidirectional=True, dropout=0.3)\n","        self.head = nn.Sequential(nn.Linear(128 * 2, 128), nn.ReLU(), nn.Dropout(0.4), nn.Linear(128, n_classes))\n","\n","    def forward(self, x):\n","        out, _ = self.gru(x)\n","        out = torch.mean(out, dim=1)\n","        return self.head(out)\n","\n","model = RadioNet(len(np.unique(y_data))).to(device)\n","optimizer = optim.Adam(model.parameters(), lr=0.001)\n","criterion = nn.CrossEntropyLoss()\n","scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, 'min', patience=5, factor=0.5)\n","\n","# --- 4. ENTRENAMIENTO CON SEGUIMIENTO ---\n","history = {'loss': [], 'lr': []}\n","print(\"Entrenando RNN...\")\n","for epoch in range(80):\n","    model.train()\n","    epoch_loss = 0\n","    for xb, yb in train_loader:\n","        xb, yb = xb.to(device), yb.to(device)\n","        optimizer.zero_grad()\n","        loss = criterion(model(xb), yb)\n","        loss.backward()\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n","        optimizer.step()\n","        epoch_loss += loss.item()\n","\n","    avg_loss = epoch_loss/len(train_loader)\n","    history['loss'].append(avg_loss)\n","    history['lr'].append(optimizer.param_groups[0]['lr'])\n","    scheduler.step(avg_loss)\n","    if (epoch+1) % 20 == 0: print(f\"Epoch {epoch+1}/80 | Loss: {avg_loss:.4f}\")\n","\n","# --- 5. ANÁLISIS Y GRÁFICAS ---\n","model.eval()\n","all_preds = []\n","with torch.no_grad():\n","    for xb, yb in test_loader:\n","        xb = xb.to(device)\n","        all_preds.extend(torch.argmax(model(xb), 1).cpu().numpy())\n","\n","acc = accuracy_score(y_test, all_preds)\n","\n","# Gráfica 1: Curva de Pérdida\n","plt.figure(figsize=(12, 4))\n","plt.subplot(1, 2, 1)\n","plt.plot(history['loss'], color='darkorange', lw=2)\n","plt.title('Evolución de la Pérdida (Loss)')\n","plt.xlabel('Época'); plt.ylabel('CrossEntropy')\n","plt.grid(alpha=0.3)\n","\n","# Gráfica 2: Matriz de Confusión\n","plt.subplot(1, 2, 2)\n","cm = confusion_matrix(y_test, all_preds)\n","disp = ConfusionMatrixDisplay(confusion_matrix=cm)\n","disp.plot(cmap='Blues', ax=plt.gca(), colorbar=False)\n","plt.title(f'Matriz de Confusión (Acc: {acc*100:.2f}%)')\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"\\n✅ PROCESO COMPLETADO. PRECISIÓN FINAL: {acc*100:.2f}%\")"]}],"metadata":{"accelerator":"GPU","colab":{"gpuType":"T4","provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}